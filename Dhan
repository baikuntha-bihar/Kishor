@Component
@RequiredArgsConstructor
public class DhanaLaxmiRetailCorpEncryptionDecryptionUtil {

    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    private static final String ENC_KEY = "0620c6bca96baa252190504dfd568b8c0a2d146f8ebdb2577bba6f9500f0af84";
    private static final String ENC_IV = "add84f1e3b6a74e8609fcdbc";

    public static String encryptDhanalaxmiRetail(String plaintext, String hexKey, String hexIv) throws Exception {
        byte[] keyBytes = hexToBytes(hexKey);
        byte[] ivBytes = hexToBytes(hexIv);
        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
        GCMParameterSpec spec = new GCMParameterSpec(128, ivBytes);
        SecretKeySpec keySpec = new SecretKeySpec(keyBytes, "AES");
        cipher.init(Cipher.ENCRYPT_MODE, keySpec, spec);
        byte[] ciphertext = cipher.doFinal(plaintext.getBytes(StandardCharsets.UTF_8));
        return Base64.getEncoder().encodeToString(ciphertext);
    }

    public static String decryptDhanalaxmiRetail(String cipherText, String hexKey, String hexIv) throws Exception {
        byte[] keyBytes = hexToBytes(hexKey);
        byte[] ivBytes = hexToBytes(hexIv);
        byte[] cipherBytes = Base64.getDecoder().decode(cipherText);
        Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
        GCMParameterSpec spec = new GCMParameterSpec(128, ivBytes);
        SecretKeySpec keySpec = new SecretKeySpec(keyBytes, "AES");
        cipher.init(Cipher.DECRYPT_MODE, keySpec, spec);
        byte[] decrypted = cipher.doFinal(cipherBytes);
        return new String(decrypted, StandardCharsets.UTF_8);
    }

    public static byte[] hexToBytes(String hex) {
        int len = hex.length();
        byte[] data = new byte[len / 2];
        for (int i = 0; i < len; i += 2) {
            data[i / 2] = (byte) ((Character.digit(hex.charAt(i), 16) << 4) + Character.digit(hex.charAt(i + 1), 16));
        }
        return data;
    }

    public static String checkSumDhanalaxmiRetail(String hashSrc) {
        try {
            MessageDigest md = MessageDigest.getInstance("SHA-512");
            md.update(hashSrc.getBytes(StandardCharsets.UTF_8));
            byte[] byteData = md.digest();
            StringBuilder sb = new StringBuilder();
            for (byte byteDatum : byteData) {
                sb.append(Integer.toString((byteDatum & 255) + 512, 16).substring(1));
            }
            return sb.toString();
        } catch (Exception e) {
            logger.error("Exception while generating SHA-512 checksum: {}", e.getMessage());
            throw new RuntimeException("SHA-512 Error", e);
        }
    }

    public String formatedAmount(BigDecimal amount) {
        if (amount == null) return "0.00";
        return new DecimalFormat("0.00").format(amount.setScale(2, RoundingMode.HALF_UP));
    }

    public Map<String, String> getDecryptedData(String decResponse) {
        return Arrays.stream(decResponse.split("&"))
                .map(kv -> kv.split("=", 2))
                .filter(kvArray -> kvArray.length == 2)
                .collect(Collectors.toMap(
                        kv -> kv[0].trim().toUpperCase(), 
                        kv -> kv[1].trim()
                ));
    }

    public String createPlainWebRequest(TransactionDto transactionDto, String returnUrl, String channelType) {
        if ("CORPORATE".equalsIgnoreCase(channelType)) {
            logger.info("Generating CORPORATE plain web request with ACTNO for ATRN: {}", transactionDto.getAtrnNum());
            return String.format("PID=PGREFID&PRN=%s&AMT=%s&CRN=INR&RU=%s&MNSBI=CorpMerchant&ACTNO=%s",
                    transactionDto.getAtrnNum(),
                    formatedAmount(transactionDto.getDebitAmt()),
                    returnUrl,
                    transactionDto.getCorporateAccountNo() != null ? transactionDto.getCorporateAccountNo() : ""
            );
        } else {
            logger.info("Generating RETAIL plain web request for ATRN: {}", transactionDto.getAtrnNum());
            return String.format("PID=PGREFID&PRN=%s&AMT=%s&CRN=INR&RU=%s&MNSBI=RetailMerchant",
                    transactionDto.getAtrnNum(),
                    formatedAmount(transactionDto.getDebitAmt()),
                    returnUrl
            );
        }
    }

    public String processDhanalaxmiDoubleVerRequest1(DhanalaxmiResponseDto responseDto) {
        String amt = formatedAmount(responseDto.getAmount());
        String prn = responseDto.getAtrn();
        
        String checksumInput = String.format("PRN=%s&AMT=%s", prn, amt);
        String checksum = checkSumDhanalaxmiRetail(checksumInput);
        
        logger.info("Built DV Request Checksum for PRN: {}", prn);
        return String.format("PRN=%s&AMT=%s&CHECKSUM=%s", prn, amt, checksum);
    }

    public String buildDvResponseChecksumString(String prn, String bid, String paid, String amt, String accNo, String payDate, String remName, String payRefNo) {
        return String.format("PRN=%s&BID=%s&PAID=%s&AMT=%s&ACCOUNTNO=%s&PAYDATE=%s&REMNAME=%s&PAYREFNO=%s",
                prn, bid, paid, amt, accNo, payDate, remName, payRefNo);
    }
