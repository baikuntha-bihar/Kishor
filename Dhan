package com.epay.otherinb.externalservice;

import com.epay.otherinb.dto.DhanlaxmiDvRequestJson;
import com.epay.otherinb.dto.DhanlaxmiDvResponseJson;
import com.epay.otherinb.exceptions.OtherInbPaymentException;
import com.epay.otherinb.util.constants.ErrorConstants;
import com.sbi.epay.logging.utility.LoggerFactoryUtility;
import com.sbi.epay.logging.utility.LoggerUtility;
import lombok.RequiredArgsConstructor;
import org.springframework.http.MediaType;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;

@RequiredArgsConstructor
@Component
public class DhanalaxmiPaymentWebClientService {

    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    private static final String DV_API_URL = "https://ngib.dhanbank.in:8443/rib-rest/payment/paymentDoubleVerification";

    public DhanlaxmiDvResponseJson processingDoubleVerRequest(String encryptedDvData) {
        logger.info("Initiating Dhanlaxmi Double Verification API");

        DhanlaxmiDvRequestJson requestJson = DhanlaxmiDvRequestJson.builder()
                .merchantID("PGREFID")
                .encDhanBankData(encryptedDvData)
                .build();

        try {
            WebClient webClient = WebClient.builder().build();
            DhanlaxmiDvResponseJson response = webClient.post()
                    .uri(DV_API_URL)
                    .contentType(MediaType.APPLICATION_JSON)
                    .bodyValue(requestJson)
                    .retrieve()
                    .onStatus(status -> status.is4xxClientError() || status.is5xxServerError(),
                            clientResponse -> clientResponse.bodyToMono(String.class)
                                    .flatMap(error -> {
                                        logger.error("DV API Error Response: {}", error);
                                        return Mono.error(new OtherInbPaymentException(
                                                ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, "DV API Error: " + error));
                                    }))
                    .bodyToMono(DhanlaxmiDvResponseJson.class)
                    .block();
            
            logger.info("DV API Response Status Code: {}", response != null ? response.getStatusCode() : "null");
            return response;
            
        } catch (Exception e) {
            logger.error("Exception during DV Call: {}", e.getMessage());
            throw new OtherInbPaymentException(ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE, 
                    ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE);
        }
    }
}


