    private final DhanaLaxmiRetailCorpEncryptionDecryptionUtil dhanaLaxmiRetailCorpEncryptionDecryptionUtil;


    public String processingDoubleVerRequest(String plainDvRequestAndChecksum){

        try {

            String encryptedDVData= DhanaLaxmiRetailCorpEncryptionDecryptionUtil.encryptDhanalaxmiRetail(plainDvRequestAndChecksum, "0620c6bca96baa252190504dfd568b8c0a2d146f8ebdb2577bba6f9500f0af84", "add84f1e3b6a74e8609fcdbc");
            logger.info("Payment Callback Encrypted and Encoded Double Verification {} " + encryptedDVData);



            String DVResponse = Optional.ofNullable(DhanalaxmiDVResponseConn(otherInbConfigDetails.getMerchantResponseView(),
                            (OtherInbConstants.DHANALAXMI_MERCH_CODE_CONST_URL)
                                    .concat("mid")
                                    .concat(OtherInbConstants.DHANALAXMI_ENC_DATA).concat(encryptedDVData)))
                    .filter(x -> !x.isEmpty()).orElseThrow(() -> new OtherInbPaymentException(ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE, ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE));
            logger.info("Payment Callback Encrypted Double Verification Response {} ", DVResponse);

//            String decryptedDVResponse = URLDecoder.decode(DhanaUtil.decrypt(DVResponse.trim().replaceAll(PaymentConstants.NEW_LINE_REGEX, PaymentConstants.PATTERN_EMPTY).replace(PaymentConstants.PATTERN_SPACE, PaymentConstants.PATTERN_EMPTY), otherInbConfigDetails.getEncryptionKey()), StandardCharsets.UTF_8);
//            logger.info("Payment Callback Decrypted and Decode Double Verification Response {} ", decryptedDVResponse);
            //       return decryptedDVResponse;
            return DVResponse;
        } catch (Exception e) { // Exception throw by INB Bank Algorithm
            logger.error("Exception While processingDoubleVerRequest  {}", e);
            throw new OtherInbPaymentException(ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE, ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE);
        }
