@RequiredArgsConstructor
@Service
public class DhanalaxmiPaymentService {
    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final OtherInbPaymentValidator otherInbpaymentValidator;
    private final DhanalaxmiPaymentWebClientService dhanalaxmiPaymentWebClientService;
    private final DhanaLaxmiRetailCorpEncryptionDecryptionUtil dhanaLaxmiRetailCorpEncryptionDecryptionUtil;
    private final TransactionDao transactionDao;
    private final OtherInbConfigDetails otherInbConfigDetails;
    private final OrderDao orderDao;
    private final PaymentCallbackForwardService paymentCallbackForwardService;
    private final OtherInbPaymentValidator otherInbPaymentValidator;


    public RedirectView processDhanalaxmiWebResponsePayload(String webResponse) throws InvalidAlgorithmParameterException, IllegalBlockSizeException, NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException, InvalidKeyException {
        PaymentFinalResponse paymentFinalResponse = processDhanalaxmiCallBack(webResponse);
        logger.info("Payment Dhanalaxmi response to transaction service paymentFinalResponse {} ", paymentFinalResponse);
        TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(paymentFinalResponse.getAtrn(), paymentFinalResponse.getTransactionStatus().toUpperCase().equalsIgnoreCase(OtherInbConstants.FAILURE_CONST) ? OtherInbConstants.FAILED : paymentFinalResponse.getTransactionStatus().toUpperCase());
        RedirectView redirectView = new RedirectView();
        redirectView.setUrl((otherInbConfigDetails.getMerchantResponseView()).concat(OtherInbConstants.MERCHANT_FINAL_RESPONSE).concat(Base64.getEncoder().encodeToString(paymentCallbackForwardService.processCallbackResponse(paymentFinalResponse, transactionDto, orderDao.getOrderDetails(transactionDto)).getBytes())));
        return redirectView;
    }

    public PaymentFinalResponse processDhanalaxmiCallBack(String webResponse) throws InvalidAlgorithmParameterException, IllegalBlockSizeException, NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException, InvalidKeyException {
        // Decrypt Web response
        String decryptedWebResponse = Optional.of(DhanaLaxmiRetailCorpEncryptionDecryptionUtil.decryptDhanalaxmiRetail(webResponse.replaceAll(OtherInbConstants.NEW_LINE_REGEX, OtherInbConstants.PATTERN_EMPTY).replace(OtherInbConstants.PATTERN_SPACE, OtherInbConstants.PATTERN_EMPTY), "0620c6bca96baa252190504dfd568b8c0a2d146f8ebdb2577bba6f9500f0af84", "add84f1e3b6a74e8609fcdbc")).filter(x -> !x.isEmpty()).orElseThrow(() -> new OtherInbPaymentException(ErrorConstants.DHANALAXMI_WEB_RESPONSE_ERROR_CODE, ErrorConstants.DHANALAXMI_WEB_RESPONSE_ERROR_MESSAGE));
        logger.info("Payment Callback Decrypted Web Response {} ", decryptedWebResponse);
        otherInbpaymentValidator.validateDhanalaxmiWebResponse(dhanaLaxmiRetailCorpEncryptionDecryptionUtil.getDecryptedData(decryptedWebResponse));
        // Create web response DTO.
        DhanalaxmiResponseDto dhanalaxmiMapWebResponseDto = Optional.ofNullable(new ObjectMapper().convertValue(DhanaLaxmiRetailCorpEncryptionDecryptionUtil.decryptDhanalaxmiRetail(decryptedWebResponse, "", ""), DhanalaxmiResponseDto.class)).orElseThrow(() -> new OtherInbPaymentException(ErrorConstants.DHANALAXMI_WEB_RESPONSE_ERROR_CODE, ErrorConstants.DHANALAXMI_WEB_RESPONSE_ERROR_MESSAGE));
        logger.info("Payment Callback Decrypted Web Response dhanalaxmiMapWebResponseDto {} ", dhanalaxmiMapWebResponseDto);
        // Save Web response in DB
        //  paymentDao.saveResponseLog(decryptedWebResponse, dhanalaxmiMapWebResponseDto.getOrderid(), dhanalaxmiMapWebResponseDto.getRefid(), OtherInbConstants.WEB_RESPONSE_TYPE, OtherInbConstants.CREATED_BY_DHANALAXMI);
        if (!dhanalaxmiMapWebResponseDto.getPaId().equalsIgnoreCase(OtherInbConstants.DHANALAXMI_STATUS_SUCCESS_CONST)) {
            //   statusUpdatePaymentDao.paymentFailureStatusUpdate(dhanalaxmiMapWebResponseDto.getOrderid(), dhanalaxmiMapWebResponseDto.getRefid(), dhanalaxmiMapWebResponseDto.getStatusmessage(), OtherInbConstants.DHANALAXMI_BANKING_RESPONSE);
            return getRedirectObject(dhanalaxmiMapWebResponseDto);
        }
        // Check Web Checksum with created checksum.
        validateWebResponseCheckSum(dhanalaxmiMapWebResponseDto);
        // Validated PaymentResponse for Dhanalaxmi
        DhanalaxmiResponseDto callBackResponse = mapCallBackResponse(dhanalaxmiMapWebResponseDto);
        otherInbpaymentValidator.validateDhanalaxmicallBack(callBackResponse);
        // atrn txn status is BOOKED and payment status is PAYMENT_INITIATION_START / amount Validation
        dhanalaxmiDvinitiationProcess(callBackResponse);
        //Redirecting to Browser.
        return getRedirectObject(dhanalaxmiMapWebResponseDto);
    }

    public PaymentFinalResponse dhanalaxmiDvinitiationProcess(DhanalaxmiResponseDto dhanalaxmiResponseDto) throws InvalidAlgorithmParameterException, IllegalBlockSizeException, NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException, InvalidKeyException {
        transactionDao.getValidPaymentAckReq(dhanalaxmiResponseDto.getAtrn(), PaymentStatus.BOOKED.toString(), OtherInbConstants.DHANALAXMI_CONST);

        switch (dhanalaxmiResponseDto.getPaId()) {
            case OtherInbConstants.DHANALAXMI_STATUS_SUCCESS_CONST -> {
                String dvRequestString = dhanaLaxmiRetailCorpEncryptionDecryptionUtil.processDhanalaxmiDoubleVerRequest1(dhanalaxmiResponseDto);
                logger.info("Payment Callback Plain DV Request for Dhanalaxmi {} ", dvRequestString);
                String DhanalaxmiResponse = dhanalaxmiPaymentWebClientService.processingDoubleVerRequest(dvRequestString);
                logger.info("Payment Callback Plain DV Response for Dhanalaxmi {} ", DhanalaxmiResponse);
                String decryptedDVResponse = URLDecoder.decode(DhanaLaxmiRetailCorpEncryptionDecryptionUtil.decryptDhanalaxmiRetail(DhanalaxmiResponse.trim().replaceAll(OtherInbConstants.NEW_LINE_REGEX, OtherInbConstants.PATTERN_EMPTY).replace(OtherInbConstants.PATTERN_SPACE, OtherInbConstants.PATTERN_EMPTY), "0620c6bca96baa252190504dfd568b8c0a2d146f8ebdb2577bba6f9500f0af84", "add84f1e3b6a74e8609fcdbc"), StandardCharsets.UTF_8);
                logger.info("Payment Callback Decrypted and Decode Double Verification Response {} ", decryptedDVResponse);
                DhanalaxmiDvResponseDto dhanalaxmimapDVResponseDto = convertDvResponsetoDto(decryptedDVResponse);
                if (!dhanalaxmimapDVResponseDto.getPrn().equalsIgnoreCase(OtherInbConstants.DHANALAXMI_STATUS_SUCCESS_CONST)) {
//                    statusUpdatePaymentDao.paymentFailureStatusUpdate(dhanalaxmiResponseDto.getPrn(), dhanalaxmiResponseDto.getBId(), dhanalaxmiResponseDto.getStatusmessage(), OtherInbConstants.DHANALAXMI_BANKING_RESPONSE);
                    DhanalaxmiResponseDto MapWebResponseDto = DhanalaxmiResponseDto.builder().paId(dhanalaxmimapDVResponseDto.getPaId()).paId(dhanalaxmimapDVResponseDto.getPaId()).atrn(dhanalaxmimapDVResponseDto.getPrn()).build();
                    return getRedirectObject(MapWebResponseDto);
                }
                logger.info("Payment Callback dhanalaxmimapDVResponseDto@@@@@@ for Dhanalaxmi {} ", dhanalaxmimapDVResponseDto);
                validateCallBackResponse(dhanalaxmiResponseDto, dhanalaxmimapDVResponseDto); // Check Method...
                DhanalaxmiDvResponseDto dhanalaxmiDvResponseDto = dhanaLaxmiRetailCorpEncryptionDecryptionUtil.processDhanalaxmiDoubleVerRequest(dhanalaxmiResponseDto);
                logger.info("Payment Callback DhanalaxmiDvResponseDto for Dhanalaxmi {} ", dhanalaxmiDvResponseDto);
            }
            default -> {
//                statusUpdatePaymentDao.paymentFailureStatusUpdate(dhanalaxmiResponseDto.getOrderid(), dhanalaxmiResponseDto.getRefid(), dhanalaxmiResponseDto.getStatusmessage(), OtherInbConstants.DHANALAXMI_BANKING_RESPONSE);
                return getRedirectObject(dhanalaxmiResponseDto);
            }
        }
        return getRedirectObject(dhanalaxmiResponseDto);
    }


    public PaymentFinalResponse getRedirectObject(DhanalaxmiResponseDto dhanalaxmiResponseDto) {
        logger.info("Payment Callback DhanalaxmiDvResponseDto######## for Dhanalaxmi atrn : {} status : {} paymodecode : {} ", dhanalaxmiResponseDto.getAtrn(), dhanalaxmiResponseDto.getPaId().equalsIgnoreCase(OtherInbConstants.ZERO) ? OtherInbConstants.SUCCESS : OtherInbConstants.FAILED, OtherInbConstants.DHANALAXMI_CONST);
        TransactionDto transactionDto = transactionDao.getTransactionDetails(dhanalaxmiResponseDto.getAtrn());
        logger.info("Payment Callback DhanalaxmiDvResponseDto######## for Dhanalaxmi {} ", transactionDto);
        Order order = orderDao.getOrderDetails(transactionDto);
        FinalResponseStatus finalResponseStatus = getStatus(transactionDto, order, dhanalaxmiResponseDto.getPaId() == null ? OtherInbConstants.EMPTY : dhanalaxmiResponseDto.getPaId().equalsIgnoreCase(OtherInbConstants.ZERO) ? OtherInbConstants.SUCCESS : OtherInbConstants.FAILED, dhanalaxmiResponseDto.getPaId() == null ? OtherInbConstants.EMPTY : dhanalaxmiResponseDto.getPaId());
        return PaymentFinalResponse.builder().mId(transactionDto.getMerchantId() == null ? OtherInbConstants.EMPTY : transactionDto.getMerchantId()).merchantOrderNumber(transactionDto.getOrderRefNumber() == null ? OtherInbConstants.EMPTY : transactionDto.getOrderRefNumber()).sbiOrderId(transactionDto.getSbiOrderRefNumber() == null ? OtherInbConstants.EMPTY : transactionDto.getSbiOrderRefNumber()).orderAmount(String.valueOf(transactionDto.getOrderAmount() == null ? OtherInbConstants.EMPTY : String.valueOf(transactionDto.getOrderAmount()))).totalAmount(String.valueOf(transactionDto.getDebitAmt()) == null ? OtherInbConstants.EMPTY : String.valueOf(transactionDto.getDebitAmt())).atrn(transactionDto.getAtrnNum() == null ? OtherInbConstants.EMPTY : transactionDto.getAtrnNum()).transactionStatus(finalResponseStatus.getStatus()).reason(finalResponseStatus.getResponseReason()).CIN(transactionDto.getCin() == null ? OtherInbConstants.EMPTY : transactionDto.getCin()).otherDetails(order.getOtherDetails() == null ? OtherInbConstants.EMPTY : order.getOtherDetails()).bankName(transactionDto.getChannelBank() == null ? OtherInbConstants.EMPTY : transactionDto.getChannelBank()).bankTxnNumber(dhanalaxmiResponseDto.getTId() == null ? OtherInbConstants.EMPTY : dhanalaxmiResponseDto.getTId()).bankCode(transactionDto.getPayMode() == null ? OtherInbConstants.EMPTY : transactionDto.getPayMode()).customerId(order.getCustomerId() == null ? OtherInbConstants.EMPTY : order.getCustomerId()).orderRetryCount(String.valueOf(order.getOrderRetryCount()) == null ? OtherInbConstants.EMPTY : String.valueOf(order.getOrderRetryCount())).build();
    }

    public FinalResponseStatus getStatus(TransactionDto transactionDto, Order order, String channelStatus, String failureReason) {
        if (!transactionDto.getOrderAmount().equals(order.getOrderAmount())) {
            return FinalResponseStatus.builder().status(OtherInbConstants.FAILED).responseReason(OtherInbConstants.FAILED_FOR_AMOUNT_NOT_MATCHED).build();
        } else {
            return FinalResponseStatus.builder().status(channelStatus).responseReason(failureReason.replaceAll(OtherInbConstants.SPECIAL_CHAR_REGEX, OtherInbConstants.EMPTY)).build();
        }
    }


    public DhanalaxmiResponseDto mapCallBackResponse(DhanalaxmiResponseDto dhanalaxmiResponseDto) {
        return DhanalaxmiResponseDto.builder().atrn(dhanalaxmiResponseDto.getAtrn()).amount(dhanalaxmiResponseDto.getAmount()).atrn(dhanalaxmiResponseDto.getAtrn()).paId(dhanalaxmiResponseDto.getPaId()).paId(dhanalaxmiResponseDto.getPaId()).paId(dhanalaxmiResponseDto.getPaId()).build();
    }


    public PaymentFinalResponse validateWebResponseCheckSum(DhanalaxmiResponseDto dhanalaxmiResponseDto) {

        String webResData = Arrays.stream(MessageFormat.format(OtherInbConstants.DHANALAXMI_WEB_CHECKSUM, dhanalaxmiResponseDto.getPaId(), dhanalaxmiResponseDto.getPaId(), dhanaLaxmiRetailCorpEncryptionDecryptionUtil.formatedAmount(dhanalaxmiResponseDto.getAmount()), dhanalaxmiResponseDto.getPaId(), dhanalaxmiResponseDto.getTId()).split("\\|")).map(String::trim).map(s -> "'" + s + "'").collect(Collectors.joining());
        logger.info("Payment Initiation using builder webResData {} for Dhanalaxmi : ", webResData);

        if (!otherInbpaymentValidator.checkSum(dhanalaxmiResponseDto.getChecksum(), (DhanaLaxmiRetailCorpEncryptionDecryptionUtil.checkSumDhanalaxmiRetail(webResData)))) {
//            statusUpdatePaymentDao.paymentFailureStatusUpdate(dhanalaxmiResponseDto.getOrderid(), dhanalaxmiResponseDto.getRefid(),ErrorConstant.WEB_CHECKSUM_MISMATCH_ERROR_MESSAGE, OtherInbConstants.DHANALAXMI_BANKING_RESPONSE);
            return getRedirectObject(dhanalaxmiResponseDto);
        }
        return null;
    }


    private PaymentFinalResponse validateCallBackResponse(DhanalaxmiResponseDto dhanalaxmiResponseDto, DhanalaxmiDvResponseDto dhanalaxmiDVResponseDto) {
        //Amount conversion for checksum
        String dvResData = Arrays.stream(MessageFormat.format(OtherInbConstants.DHANALAXMI_WEB_CHECKSUM, dhanalaxmiDVResponseDto.getPaId(), dhanalaxmiDVResponseDto.getPrn(), dhanalaxmiDVResponseDto.getBId(), dhanaLaxmiRetailCorpEncryptionDecryptionUtil.formatedAmount(dhanalaxmiDVResponseDto.getAmount()), dhanalaxmiDVResponseDto.getPaId(), dhanalaxmiDVResponseDto.getPrn()).split("\\|")).map(String::trim).map(s -> "'" + s + "'").collect(Collectors.joining());
        logger.info("Payment Initiation using builder webResData {} for Dhanalaxmi : ", dvResData);

        logger.info("Payment Callback DV create Checksum {} ", DhanaLaxmiRetailCorpEncryptionDecryptionUtil.checkSumDhanalaxmiRetail(dvResData));
        if (!otherInbpaymentValidator.checkSum(String.valueOf(dhanalaxmiDVResponseDto.hashCode()), (DhanaLaxmiRetailCorpEncryptionDecryptionUtil.checkSumDhanalaxmiRetail(dvResData)))) {
            //     statusUpdatePaymentDao.paymentFailureStatusUpdate(dhanalaxmiResponseDto.getOrderid(), dhanalaxmiResponseDto.getRefid(),ErrorConstant.DV_CHECKSUM_MISMATCH_ERROR_MESSAGE, OtherInbConstants.DHANALAXMI_BANKING_RESPONSE);
            return getRedirectObject(dhanalaxmiResponseDto);
        }
        if (!otherInbpaymentValidator.validateWebAndDvAmt(dhanalaxmiResponseDto.getAmount(), dhanalaxmiDVResponseDto.getAmount())) {
//            statusUpdatePaymentDao.paymentFailureStatusUpdate(dhanalaxmiResponseDto.getOrderid(), dhanalaxmiResponseDto.getRefid(),ErrorConstant.AMOUNT_ERROR_MESSAGE, OtherInbConstants.DHANALAXMI_BANKING_RESPONSE);
            return getRedirectObject(dhanalaxmiResponseDto);
        }
        if (!otherInbpaymentValidator.ValidateBankReferenceNumber(dhanalaxmiResponseDto.getAtrn(), dhanalaxmiDVResponseDto.getBId())) {
//            statusUpdatePaymentDao.paymentFailureStatusUpdate(dhanalaxmiResponseDto.getOrderid(), dhanalaxmiResponseDto.getRefid(),ErrorConstant.BANK_REF_NO_ERROR_MESSAGE, OtherInbConstants.DHANALAXMI_BANKING_RESPONSE);
            return getRedirectObject(dhanalaxmiResponseDto);
        }
        return null;
    }


    public DhanalaxmiDvResponseDto convertDvResponsetoDto(String dhanalaxmiDvResponse) {
        logger.info("Payment Callback MapDVResponseDto for Dhanalaxmi {} ", dhanalaxmiDvResponse);
        try {
            return new ObjectMapper().readValue(dhanalaxmiDvResponse, DhanalaxmiDvResponseDto.class);

        } catch (JsonProcessingException e) {
            throw new OtherInbPaymentException(ErrorConstants.DHANALAXMI_DV_RESPONSE_PROCESS_ERROR_CODE, ErrorConstants.DHANALAXMI_DV_RESPONSE_PROCESS_MESSAGE);
        }

    }
}
