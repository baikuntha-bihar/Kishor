package com.epay.otherinb.externalservice;

import com.epay.otherinb.config.OtherInbConfigDetails;
import com.epay.otherinb.exceptions.OtherInbPaymentException;
import com.epay.otherinb.util.constants.ErrorConstants;
import com.epay.otherinb.util.constants.OtherInbConstants;
import com.epay.otherinb.util.encryptdecryptutil.ICICIRetailEncryptionDecryptionUtil;
import com.sbi.epay.logging.utility.LoggerFactoryUtility;
import com.sbi.epay.logging.utility.LoggerUtility;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;
import reactor.util.retry.Retry;

import java.text.MessageFormat;
import java.time.Duration;
import java.util.Optional;
import java.util.function.Supplier;

@RequiredArgsConstructor
@Component
public class ICICIPaymentWebClientService {

    // Matched Dhanalaxmi style: removed 'private final' from logger
    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    
    private final OtherInbConfigDetails otherInbConfigDetails;
    
    // Spring now injects this successfully because of the ICICIConfig.java String bean
    private final ICICIRetailEncryptionDecryptionUtil iciciRetailEncryptionDecryptionUtil;

    public String processingDoubleVerRequest(String plainDvRequestAndChecksum) {
        try {
            // Using the injected bean
            String encryptedDVData = iciciRetailEncryptionDecryptionUtil.iciciEncrypt(plainDvRequestAndChecksum);
            
            // Matched Dhanalaxmi's exact logging concatenation style
            logger.info("Payment Callback Encrypted and Encoded Double Verification {} " + encryptedDVData);

            // Matched Dhanalaxmi's exact Optional filtering and exception throwing
            String DVResponse = Optional.ofNullable(ICICIDVResponseConn(otherInbConfigDetails.getMerchantResponseView(), (OtherInbConstants.ICICI_MERCH_CODE_CONST_URL).concat("mid").concat(OtherInbConstants.ICICI_ENC_DATA).concat(encryptedDVData))).filter(x -> !x.isEmpty()).orElseThrow(() -> new OtherInbPaymentException(ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE, ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE));
            
            logger.info("Payment Callback Encrypted Double Verification Response {} ", DVResponse);

            return DVResponse;
        } catch (Exception e) { // Matched Dhanalaxmi's exact catch block
            logger.error("Exception While processingDoubleVerRequest  {}", e);
            throw new OtherInbPaymentException(ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE, ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE);
        }
    }

    public String ICICIDVResponseConn(String bankdvurl, String encryptedData) {
        // Matched Dhanalaxmi's exact logging concatenation
        logger.info("Other INB DV Request posting parameters DV Url {} and encryptedData {} ", bankdvurl + encryptedData);
        
        // Matched Dhanalaxmi's local logger shadowing
        LoggerUtility logger = LoggerFactoryUtility.getLogger(ICICIPaymentWebClientService.class);

        logger.info("Other INB DV Request posting parameters DV Url {} and encryptedData {} ", bankdvurl, encryptedData);
        try {
            WebClient webClient = WebClient.builder().baseUrl(bankdvurl).build();
            logger.info("webClient URL for other INB {} ", webClient);

            // Matched Dhanalaxmi's exact WebClient error handling flow, including the Supplier cast
            return webClient.post().header(OtherInbConstants.REQUESTPROPERTY, OtherInbConstants.URL_ENCODED_CONTENT_TYPE).bodyValue(encryptedData).retrieve().onStatus(status -> {
                logger.info("DV Response received status for other INB {} ", status);
                return !status.is2xxSuccessful();
            }, clientResponse -> clientResponse.bodyToMono(String.class).flatMap(errorBody -> Mono.error(((Supplier<RuntimeException>) () -> new OtherInbPaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, MessageFormat.format(ErrorConstants.EXTERNAL_SERVICE_ERROR_MESSAGE, OtherInbConstants.SBI_INB_SERVICE))).get()))).bodyToMono(String.class).doOnNext(body -> {
                logger.info("responseCode for other INB {} ", body);
            }).doOnError(error -> {
                logger.info("error responseCode for other INB {} ", error);
            }).onErrorResume(error -> {
                logger.info("error responseCode for other INB {} ", error);
                return Mono.error(() -> new OtherInbPaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, MessageFormat.format(ErrorConstants.EXTERNAL_SERVICE_ERROR_MESSAGE, OtherInbConstants.OTHER_INB_SERVICE)));
            }).retryWhen(Retry.fixedDelay(3, Duration.ofSeconds(1)).filter(throwable -> throwable instanceof OtherInbPaymentException).doBeforeRetry(retrySignal -> logger.info("Retrying attempt {} due to error: {}", retrySignal.totalRetries() + 1, retrySignal.failure().getMessage()))).block();
        } catch (Exception e) { 
            logger.error("Exception While otherINBDVResponseConn  {}", e);
            throw new OtherInbPaymentException(ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE, MessageFormat.format(ErrorConstants.EXTERNAL_SERVICE_ERROR_MESSAGE, OtherInbConstants.OTHER_INB_SERVICE));
        }
    }
}
