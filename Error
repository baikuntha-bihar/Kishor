package com.your.package.validator;

import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;

import java.math.BigDecimal;
import java.util.Map;

@Component
@RequiredArgsConstructor
public class OtherInbPaymentValidator extends BaseValidator {

    // ============================================================
    // ICICI Validations Start
    // ============================================================

    // Called right after decrypt, BEFORE building the DTO.
    // Defends: missing keys, empty map, unparseable amount.
    // NOTE: map keys must match what getDecryptedData() emits.
    //       Adjust literals if your util emits different keys.
    public void validateICICIWebResponse(Map<String, String> map) {

        // 1) Payload must not be empty
        if (map == null || map.isEmpty()) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }

        // 2) Required fields - ICICI always sends these
        validateRequired(map.get("prn"), "prn");
        validateRequired(map.get("atrn"), "atrn");
        validateRequired(map.get("paId"), "paId");
        validateRequired(map.get("bId"), "bId");
        validateRequired(map.get("itc"), "itc");
        validateRequired(map.get("crn"), "crn");

        // 3) Amount must be parseable + positive
        validateAmount(map.get("amount"), "amount");
    }

    // Called only on the SUCCESS path, AFTER mapCallBackResponse().
    // Defends: null DTO, missing critical IDs, zero/negative amount.
    public void validateICICIcallBack(ICICIResponseDto response) {

        // 1) DTO must exist
        if (response == null) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_CALLBACK_VALIDATION_ERROR_CODE,
                    ErrorConstants.ICICI_CALLBACK_VALIDATION_ERROR_MESSAGE);
        }

        // 2) Required identifiers
        validateRequired(response.getAtrn(), "atrn");
        validateRequired(response.getPrn(), "prn");
        validateRequired(response.getPaId(), "paId");
        validateRequired(response.getBId(), "bId");

        // 3) Amount sanity
        if (response.getAmount() == null
                || response.getAmount().compareTo(BigDecimal.ZERO) <= 0) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_CALLBACK_VALIDATION_ERROR_CODE,
                    ErrorConstants.ICICI_CALLBACK_VALIDATION_ERROR_MESSAGE);
        }

        // 4) paId must be SUCCESS on this path
        if (!OtherInbConstants.ICICI_STATUS_SUCCESS_CONST.equalsIgnoreCase(response.getPaId())) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }
    }

    // ============================================================
    // ICICI Validations End
    // ============================================================

    // ------------------------------------------------------------
    // Helper methods - use these if BaseValidator no longer has
    // validateNBRequiredCallBack / validateNBAmountCallBack.
    // If BaseValidator provides them, delete these two privates
    // and rename calls accordingly.
    // ------------------------------------------------------------
    private void validateRequired(String value, String fieldName) {
        if (value == null || value.trim().isEmpty()) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    "Missing required field: " + fieldName);
        }
    }

    private void validateAmount(String value, String fieldName) {
        if (value == null || value.trim().isEmpty()) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    "Missing amount: " + fieldName);
        }
        try {
            BigDecimal amt = new BigDecimal(value.trim());
            if (amt.compareTo(BigDecimal.ZERO) <= 0) {
                throw new OtherInbPaymentException(
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                        "Non-positive amount: " + fieldName);
            }
        } catch (NumberFormatException e) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    "Unparseable amount: " + fieldName);
        }
    }
}

