
@Service
@RequiredArgsConstructor
public class ICICIRetailPaymentService {

    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    private final OtherInbPaymentValidator otherInbpaymentValidator;
    private final ICICIPaymentWebClientService iCICIPaymentWebClientService;
    private final ICICIRetailEncryptionDecryptionUtil iciciRetailEncryptionDecryptionUtil;
    private final TransactionDao transactionDao;
    private final OtherInbConfigDetails otherInbConfigDetails;
    private final OrderDao orderDao;
    private final PaymentCallbackForwardService paymentCallbackForwardService;

    public RedirectView processICICIWebResponsePayload(String webResponse) throws InvalidAlgorithmParameterException, IllegalBlockSizeException, NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException, InvalidKeyException, IOException {
        PaymentFinalResponse paymentFinalResponse = processICICICallBack(webResponse);
        logger.info("Payment ICICI response to transaction service paymentFinalResponse {} ", paymentFinalResponse);

        String txnStatus = Optional.ofNullable(paymentFinalResponse.getTransactionStatus()).map(String::toUpperCase).orElse(OtherInbConstants.EMPTY);

        TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(paymentFinalResponse.getAtrn(), OtherInbConstants.FAILURE_CONST.equalsIgnoreCase(txnStatus) ? OtherInbConstants.FAILED : txnStatus);

        RedirectView redirectView = new RedirectView();
        redirectView.setUrl((otherInbConfigDetails.getMerchantResponseView()).concat(OtherInbConstants.MERCHANT_FINAL_RESPONSE).concat(Base64.getEncoder().encodeToString(paymentCallbackForwardService.processCallbackResponse(paymentFinalResponse, transactionDto, orderDao.getOrderDetails(transactionDto)).getBytes(StandardCharsets.UTF_8))));
        return redirectView;
    }

    public PaymentFinalResponse processICICICallBack(String webResponse) throws InvalidAlgorithmParameterException, IllegalBlockSizeException, NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException, InvalidKeyException, IOException {
        String decryptedWebResponse = Optional.ofNullable(iciciRetailEncryptionDecryptionUtil.iciciDecrypt(webResponse.replaceAll(OtherInbConstants.NEW_LINE_REGEX, OtherInbConstants.PATTERN_EMPTY).replace(OtherInbConstants.PATTERN_SPACE, OtherInbConstants.PATTERN_EMPTY))).filter(x -> !x.isEmpty()).orElseThrow(() -> new OtherInbPaymentException(ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE, ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE));
        logger.info("Payment Callback Decrypted Web Response {} ", decryptedWebResponse);
        Map<String, String> decryptedMap = iciciRetailEncryptionDecryptionUtil.getDecryptedData(decryptedWebResponse);
        otherInbpaymentValidator.validateICICIWebResponse(decryptedMap);
        ICICIResponseDto iciciMapWebResponseDto = Optional.ofNullable(new ObjectMapper().convertValue(decryptedMap, ICICIResponseDto.class)).orElseThrow(() -> new OtherInbPaymentException(ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE, ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE));
        logger.info("Payment Callback Decrypted Web Response iciciMapWebResponseDto {} ", iciciMapWebResponseDto);

        if (!OtherInbConstants.ICICI_STATUS_SUCCESS_CONST.equalsIgnoreCase(iciciMapWebResponseDto.getPaId())) {
            return getRedirectObject(iciciMapWebResponseDto);
        }
        ICICIResponseDto callBackResponse = mapCallBackResponse(iciciMapWebResponseDto);
        otherInbpaymentValidator.validateICICIcallBack(callBackResponse);
        iciciDvinitiationProcess(callBackResponse);
        return getRedirectObject(iciciMapWebResponseDto);
    }

    public PaymentFinalResponse iciciDvinitiationProcess(ICICIResponseDto iciciResponseDto) throws InvalidAlgorithmParameterException, IllegalBlockSizeException, NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException, InvalidKeyException, IOException {

        transactionDao.getValidPaymentAckReq(iciciResponseDto.getPrn(), PaymentStatus.BOOKED.toString(), OtherInbConstants.ICICI_CONST);

        switch (Optional.ofNullable(iciciResponseDto.getPaId()).orElse(OtherInbConstants.EMPTY)) {

            case OtherInbConstants.ICICI_STATUS_SUCCESS_CONST -> {
                try {
                    String dvRequestString = iciciRetailEncryptionDecryptionUtil.processICICIDoubleVerRequest1(iciciResponseDto);
                    logger.info("Payment Callback Plain DV Request for ICICI {} ", dvRequestString);

                    String ICICIResponse = iCICIPaymentWebClientService.processingDoubleVerRequest(dvRequestString);
                    logger.info("Payment Callback Plain DV Response for ICICI {} ", ICICIResponse);

                    String decryptedDVResponse = URLDecoder.decode(iciciRetailEncryptionDecryptionUtil.iciciDecrypt(ICICIResponse.trim().replaceAll(OtherInbConstants.NEW_LINE_REGEX, OtherInbConstants.PATTERN_EMPTY).replace(OtherInbConstants.PATTERN_SPACE, OtherInbConstants.PATTERN_EMPTY)), StandardCharsets.UTF_8);
                    logger.info("Payment Callback Decrypted and Decode Double Verification Response {} ", decryptedDVResponse);

                    ICICIDvResponseDto icicimapDVResponseDto = convertDvResponsetoDto(decryptedDVResponse);
                    if (icicimapDVResponseDto == null) {
                        return getRedirectObject(iciciResponseDto);
                    }

                    if (!OtherInbConstants.ICICI_STATUS_SUCCESS_CONST.equalsIgnoreCase(icicimapDVResponseDto.getPaId())) {
                        ICICIResponseDto failed = ICICIResponseDto.builder().atrn(icicimapDVResponseDto.getAtrn()).paId(icicimapDVResponseDto.getPaId()).atrn(iciciResponseDto.getAtrn()).amount(icicimapDVResponseDto.getAmount()).build();
                        return getRedirectObject(failed);
                    }

                    logger.info("Payment Callback icicimapDVResponseDto for ICICI {} ", icicimapDVResponseDto);

                    PaymentFinalResponse validationResult = validateCallBackResponse(iciciResponseDto, icicimapDVResponseDto);
                    if (validationResult != null) {
                        return validationResult;
                    }

                    ICICIDvResponseDto iciciDvResponseDto = iciciRetailEncryptionDecryptionUtil.processICICIDoubleVerRequest(iciciResponseDto);
                    logger.info("Payment Callback ICICIDvResponseDto for ICICI {} ", iciciDvResponseDto);

                } catch (OtherInbPaymentException e) {
                    throw e;
                } catch (Exception e) {
                    logger.error("Error during DV initiation for prn={}", iciciResponseDto.getPrn(), e);
                    return getRedirectObject(iciciResponseDto);
                }
            }
            default -> {
                return getRedirectObject(iciciResponseDto);
            }
        }
        return getRedirectObject(iciciResponseDto);
    }

    public PaymentFinalResponse getRedirectObject(ICICIResponseDto iciciResponseDto) {

        String paId = Optional.ofNullable(iciciResponseDto.getPaId()).orElse(OtherInbConstants.EMPTY);
        String resolvedStatus = paId.equalsIgnoreCase(OtherInbConstants.ZERO) ? OtherInbConstants.SUCCESS : OtherInbConstants.FAILED;

        logger.info("Payment Callback ICICIDvResponseDto for ICICI atrn : {} status : {} paymodecode : {} ", iciciResponseDto.getPrn(), resolvedStatus, OtherInbConstants.ICICI_CONST);

        TransactionDto transactionDto = transactionDao.getTransactionDetails(iciciResponseDto.getPrn());
        logger.info("Payment Callback ICICIDvResponseDto for ICICI {} ", transactionDto);

        Order order = orderDao.getOrderDetails(transactionDto);
        FinalResponseStatus finalResponseStatus = getStatus(transactionDto, order, resolvedStatus, paId.isEmpty() ? OtherInbConstants.EMPTY : paId);

        return PaymentFinalResponse.builder().mId(transactionDto.getMerchantId() == null ? OtherInbConstants.EMPTY : transactionDto.getMerchantId()).merchantOrderNumber(transactionDto.getOrderRefNumber() == null ? OtherInbConstants.EMPTY : transactionDto.getOrderRefNumber()).sbiOrderId(transactionDto.getSbiOrderRefNumber() == null ? OtherInbConstants.EMPTY : transactionDto.getSbiOrderRefNumber()).orderAmount(transactionDto.getOrderAmount() == null ? OtherInbConstants.EMPTY : String.valueOf(transactionDto.getOrderAmount()))
                .totalAmount(transactionDto.getDebitAmt() == null ? OtherInbConstants.EMPTY : String.valueOf(transactionDto.getDebitAmt())).atrn(transactionDto.getAtrnNum() == null ? OtherInbConstants.EMPTY : transactionDto.getAtrnNum()).transactionStatus(finalResponseStatus.getStatus()).reason(finalResponseStatus.getResponseReason()).CIN(transactionDto.getCin() == null ? OtherInbConstants.EMPTY : transactionDto.getCin()).otherDetails(order.getOtherDetails() == null ? OtherInbConstants.EMPTY : order.getOtherDetails()).bankName(transactionDto.getChannelBank() == null ? OtherInbConstants.EMPTY : transactionDto.getChannelBank()).bankTxnNumber(paId).bankCode(transactionDto.getPayMode() == null ? OtherInbConstants.EMPTY : transactionDto.getPayMode()).customerId(order.getCustomerId() == null ? OtherInbConstants.EMPTY : order.getCustomerId())
                .orderRetryCount(order.getOrderRetryCount() == null ? OtherInbConstants.EMPTY : String.valueOf(order.getOrderRetryCount())).build();
    }

    public FinalResponseStatus getStatus(TransactionDto transactionDto, Order order, String channelStatus, String failureReason) {
        if (transactionDto == null || order == null || !Objects.equals(transactionDto.getOrderAmount(), order.getOrderAmount())) {
            return FinalResponseStatus.builder().status(OtherInbConstants.FAILED).responseReason(OtherInbConstants.FAILED_FOR_AMOUNT_NOT_MATCHED).build();
        }
        String safeReason = Optional.ofNullable(failureReason).orElse(OtherInbConstants.EMPTY).replaceAll(OtherInbConstants.SPECIAL_CHAR_REGEX, OtherInbConstants.EMPTY);
        return FinalResponseStatus.builder().status(channelStatus).responseReason(safeReason).build();
    }

    public ICICIResponseDto mapCallBackResponse(ICICIResponseDto iciciResponseDto) {
        return ICICIResponseDto.builder().atrn(iciciResponseDto.getAtrn()).prn(iciciResponseDto.getPrn()).itc(iciciResponseDto.getItc()).amount(iciciResponseDto.getAmount()).crn(iciciResponseDto.getCrn()).paId(iciciResponseDto.getPaId()).bId(iciciResponseDto.getBId()).build();
    }

    private PaymentFinalResponse validateCallBackResponse(ICICIResponseDto iciciResponseDto, ICICIDvResponseDto iciciDVResponseDto) {
        if (iciciDVResponseDto == null) {
            return null;
        }
        if (!otherInbpaymentValidator.validateWebAndDvAmt(iciciResponseDto.getAmount(), iciciDVResponseDto.getAmount())) {
            return getRedirectObject(iciciResponseDto);
        }
//        if (!otherInbpaymentValidator.validateBankReferenceNumber(iciciResponseDto.getPrn(), iciciDVResponseDto.getBId())) {
//            return getRedirectObject(iciciResponseDto);
//        }
        return null;
    }

    public ICICIDvResponseDto convertDvResponsetoDto(String iciciDvResponse) {
        logger.info("Payment Callback MapDVResponseDto for ICICI {} ", iciciDvResponse);
        try {
            return new ObjectMapper().readValue(iciciDvResponse, ICICIDvResponseDto.class);
        } catch (JsonProcessingException e) {
            throw new OtherInbPaymentException(ErrorConstants.ICICI_DV_RESPONSE_PROCESS_ERROR_CODE, ErrorConstants.ICICI_DV_RESPONSE_PROCESS_MESSAGE);
        }
    }
}

