security:
  cors:
    allowed:
      origins: "*"

server:
  port: 8096
  servlet:
    context-path: /epay-bridge

spring:
  application:
    name: epay-bridge

  # Db connectivity
  jpa:
    show-sql: true
    properties:
      hibernate:
        show_sql: true
        type:
          preferred_instant_jdbc_type: TIMESTAMP
    database-platform: org.hibernate.dialect.OracleDialect
    hibernate:
      ddl-auto: update
    defer-datasource-initialization: true

  datasource:
    url: "jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=epaydbscandev.sbiepay.sbi)(PORT=1524))(CONNECT_DATA= (SERVER=DEDICATED) (SERVICE_NAME=epaydbdev.sbiepay.sbi)))"

    # url: "jdbc:oracle:thin:@10.177.134.124:1590:epaydbdev1"
    # url: "jdbc:oracle:thin:@(DESCRIPTION=(ADDRESS=(PROTOCOL=TCP)(HOST=10.177.134.124)(PORT=1590))(CONNECT_DATA= (SERVER=DEDICATED) (SERVICE_NAME=epaydbdev1)))"

    username: EPAYBRIDGE
    password: "Asdf_123"

    # username: ${DB_USERNAME}
    # password: ${DB_PASSWORD}

    driver-class-name: oracle.jdbc.OracleDriver

    # Optional settings
    hikari:
      maximum-pool-size: 10
      minimum-idle: 5
      idle-timeout: 30000
      max-lifetime: 2000000

  autoconfigure:
    exclude:
      - org.springframework.boot.autoconfigure.security.servlet.SecurityAutoConfiguration
      - org.springframework.boot.actuate.autoconfigure.security.servlet.ManagementWebSecurityAutoConfiguration

# log config
logging:
  level:
    root: INFO
    com:
      sbi:
        epay: INFO
  pattern:
    console: "%d{yyyy-MM-dd HH:mm:ss} [%X{correlationId}] [%thread] %-5level %logger{36} - %msg%n"
    file: "%d{yyyy-MM-dd HH:mm:ss} [%X{correlationId}] [%thread] %-5level %logger{36} - %msg%n"

# Encryption Configuration
epay:
  encryption:
    default-key: "default-secret-key-32-characters-long"
    algorithm: AES

# Merchant Configuration
merchant:
  config:
    cache-enabled: true
    cache-ttl-minutes: 60

# Audit Configuration
audit:
  enabled: true
  mask-sensitive-data: true
  log-request-payload: true
  log-response-payload: true

# SBIEpay API Configuration
sbiepay:
  api:
    # base-url: https://uat.epay.sbi
    base-url: "http://txn-transactionservice.dev-transaction.svc.cluster.local:9092"
    payment-endpoint: /api/transaction/v1/order/create
    status-endpoint: /api/transaction/v1/order/status
    refund-endpoint: /v2/payment/refund
    api-key: "${SBIEPAY_API_KEY:default-api-key}"
    api-secret: "${SBIEPAY_API_SECRET:default-api-secret}"
    connect-timeout: 10000
    read-timeout: 30000
    epayEncryptUrl: /api/javasimulator/v1/crypto/encrypt
    epayDecryptUrl: /api/javasimulator/v1/crypto/decrypt

    # SBIEpay OAuth2 Hosted Access Token Service Configuration
    # token-endpoint: https://uat.epay.sbi/api/transaction/v1/token/access
    token-endpoint: "http://txn-transactionservice.dev-transaction.svc.cluster.local:9092/api/transaction/v1/token/access"
    auth-client-id: "${SBIEPAY_AUTH_CLIENT_ID:demo-client-id}"
    auth-client-secret: "${SBIEPAY_AUTH_CLIENT_SECRET:demo-client-secret}"

# Resilience4j Configuration
resilience4j:
  circuitbreaker:
    instances:
      sbiepayApi:
        registerHealthIndicator: true
        failureRateThreshold: 50
        waitDurationInOpenState: 30s
        slidingWindowSize: 10
        minimumNumberOfCalls: 5

  retry:
    instances:
      sbiepayApi:
        maxAttempts: 3
        waitDuration: 2s

# Actuator Configuration (for monitoring circuit breakers)
management:
  endpoints:
    web:
      exposure:
        include:
          - health
          - info
          - metrics
          - prometheus
          - circuitbreakers

  health:
    circuitbreakers:
      enabled: true

  endpoint:
    health:
      show-details: always

  metrics:
    export:
      prometheus:
        enabled: true

# Swagger/OpenAPI Configuration (Temporarily disabled due to Spring Boot 2.7 compatibility)
# Access at https://merchant.sbiuat.bank.in/swagger-ui/ once enabled
springfox:
  documentation:
    enabled: false
    swagger-ui:
      enabled: false

# Security Configuration (Development Only - Disable Auto-Configuration)
# Adapter Callback Configuration (Pay-Redirect Flow)
adapter:
  callback:
    # base-url: https://merchant.sbiuat.bank.in/api/legacy/payment
    base-url: "http://txn-transactionservice.dev-transaction.svc.cluster.local:9092/api/legacy/payment"
    endpoint: /payment-redirect-callback
    session-timeout-minutes: 30
    max-callback-attempts: 3
    enable-ssl-validation: true

# Payment Session Configuration
payment:
  session:
    timeout-minutes: 30
    max-attempts: 3
    cleanup-schedule-minutes: 60

redirectBaseURL: "https://dev.epay.sbi/epay-bridge"
