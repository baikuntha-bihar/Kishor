    public ICICIRetailEncryptionDecryptionUtil(
            OtherInbPaymentDao otherInbPaymentDao,
            OtherInbFormPostingUtil otherInbFormPostingUtil,
            OtherInbConfigDetails otherInbConfigDetails) throws InvalidKeyException {

        this.otherInbPaymentDao = otherInbPaymentDao;
        this.otherInbFormPostingUtil = otherInbFormPostingUtil;
        this.otherInbConfigDetails = otherInbConfigDetails;

        String masterKey = otherInbConfigDetails.getIciciMasterKey();
        if (StringUtils.isBlank(masterKey) || masterKey.trim().length() != 16) {
            throw new InvalidKeyException(
                    "ICICI master key must be exactly 16 characters");
        }
        this.encryptDecryptKey = new SecretKeySpec(
                masterKey.trim().getBytes(StandardCharsets.UTF_8), AES);
    }

    // Cipher is NOT thread-safe — new instance per call
    private Cipher newCipher() throws NoSuchPaddingException, NoSuchAlgorithmException {
        return Cipher.getInstance(AES);
    }

    // ==========================================================================
    // WEB REQUEST INITIATION (ICICI)
    // ==========================================================================
    public OtherInbPostingData processInitiate(
            PaymentRequest paymentWebRequest,
            TransactionDto transactionDto,
            OtherInbChannelUnitMappingDto otherInbChannelUnitMappingDto) throws Exception {

        DateTimeFormatter formatter =
                DateTimeFormatter.ofPattern(OtherInbConstants.TXN_DATETIME_FORMAT);
        String txnDateTime = LocalDateTime.now().format(formatter);
        logger.info("ICICI txnDateTime={}", txnDateTime);

        String plainTextWebReqData =
                createWebRequest(transactionDto, otherInbChannelUnitMappingDto, txnDateTime);
        logger.info("ICICI plain web request={}", plainTextWebReqData);

        // single save call (was duplicated)
        otherInbPaymentDao.saveRequestLog(
                plainTextWebReqData,
                paymentWebRequest.getAtrn(),
                OtherInbConstants.WEB_REQUEST_TYPE,
                OtherInbConstants.CREATED_BY_ICICI);

        String encrypted = encryptedPostedData(
                plainTextWebReqData, otherInbChannelUnitMappingDto, transactionDto).getData();

        return OtherInbPostingData.builder()
                .atrn(transactionDto.getAtrnNum())
                .merchIdVal(transactionDto.getMerchantId())
                .encryptTrans(otherInbFormPostingUtil.getFormPostingData(
                        otherInbFormPostingUtil.getForm_ICICI(
                                encrypted, transactionDto, otherInbChannelUnitMappingDto),
                        otherInbChannelUnitMappingDto, transactionDto))
                .build();
    }

    public String createWebRequest(TransactionDto transactionDto,
                                   OtherInbChannelUnitMappingDto mapping,
                                   String txnDateTime) {
        return MessageFormat.format(String.valueOf(mapping.getWebRequestFormat()),
                transactionDto.getAtrnNum(),
                otherInbConfigDetails.getIciciMerchantName(),
                transactionDto.getDebitAmt(),
                transactionDto.getCurrencyCode(),
                mapping.getChannelReturnUrl(),
                OtherInbConstants.YES_CONST);
    }

    public PostingData encryptedPostedData(String plainTextWebReqData,
                                           OtherInbChannelUnitMappingDto mapping,
                                           TransactionDto transactionDto) throws Exception {
        // use injected bean's key — no hard-coded key, no `new`
        String encWebReqData = iciciEncrypt(plainTextWebReqData);
        return PostingData.builder().data(encWebReqData).build();
    }

    // ==========================================================================
    // ENCRYPT / DECRYPT
    // ==========================================================================
    public String iciciEncrypt(String stringToEncrypt)
            throws InvalidKeyException, IllegalBlockSizeException, BadPaddingException,
                   NoSuchPaddingException, NoSuchAlgorithmException {
        Cipher c = newCipher();
        c.init(Cipher.ENCRYPT_MODE, encryptDecryptKey);
        return Base64.getEncoder()
                .encodeToString(c.doFinal(
                        stringToEncrypt.getBytes(StandardCharsets.UTF_8)));
    }

    public String iciciDecrypt(String stringToDecrypt)
            throws InvalidKeyException, IllegalBlockSizeException, BadPaddingException,
                   NoSuchPaddingException, NoSuchAlgorithmException {
        Cipher c = newCipher();
        c.init(Cipher.DECRYPT_MODE, encryptDecryptKey);
        byte[] cleartext = Base64.getDecoder()
                .decode(replaceSpecialChars(stringToDecrypt));
        return new String(c.doFinal(cleartext), StandardCharsets.UTF_8);
    }

    private String replaceSpecialChars(String str) {
        if (str == null) {
            return "";
        }
        StringBuilder sb = new StringBuilder(str.length());
        for (int i = 0; i < str.length(); i++) {
            char ch = str.charAt(i);
            sb.append(ch == ' ' ? '+' : ch);
        }
        return sb.toString();
    }

    // ==========================================================================
    // PARSE PIPE-DELIMITED RESPONSE
    // ==========================================================================
    public Map<String, String> getDecryptedData(String decResponse) {
        if (StringUtils.isBlank(decResponse)) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }

        Map<String, String> result = Arrays.stream(decResponse.split("\\|"))
                .map(kv -> kv.split(OtherInbConstants.PATTERN_EQUAL_TO_CONST))
                .filter(arr -> arr.length > 1)
                .collect(Collectors.toMap(
                        arr -> arr[0].trim(),
                        arr -> StringUtils.isBlank(arr[1])
                                ? OtherInbConstants.NA
                                : arr[1].trim(),
                        (a, b) -> b)); // duplicate-key merge

        if (result.isEmpty()) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }
        return result;
    }

