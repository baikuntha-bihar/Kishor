    public String formatedAmount(BigDecimal amount) {
        if (amount == null) {
            return OtherInbConstants.EMPTY;
        }
        BigDecimal convertedAmount = amount.setScale(2, BigDecimal.ROUND_UP);
        DecimalFormat df = new DecimalFormat("0.00");
        return df.format(convertedAmount);
    }

