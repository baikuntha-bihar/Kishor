    // FIX #5 (NPE guard):
    //   decResponse.split(...) throws NPE when decResponse is null.
    //   Blank check added; existing parsing logic unchanged.
    public Map<String, String> getDecryptedData(String decResponse) {

        if (decResponse == null || decResponse.trim().isEmpty()) {
            throw new OtherInbPaymentException(
                    ErrorConstants.WEB_CHECKSUM_ERROR_CODE,
                    ErrorConstants.WEB_CHECKSUM_MISMATCH_ERROR_MESSAGE);
        }

        return Optional.of(Arrays.stream(decResponse.split("\\|"))
                        .map(kv -> kv.split(OtherInbConstants.PATTERN_EQUAL_TO_CONST))
                        .filter(kvArray -> kvArray.length > 1)
                        .collect(Collectors.toMap(
                                kv -> kv[0],
                                kv -> StringUtils.isBlank(kv[1])
                                        ? OtherInbConstants.NA
                                        : kv[1].trim())))
                .orElseThrow(() -> new OtherInbPaymentException(
                        ErrorConstants.WEB_CHECKSUM_ERROR_CODE,
                        ErrorConstants.WEB_CHECKSUM_MISMATCH_ERROR_MESSAGE));
    }

