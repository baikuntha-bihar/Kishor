@Service
@RequiredArgsConstructor
public class ICICIRetailPaymentService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    private final OtherInbPaymentValidator otherInbpaymentValidator;
    private final ICICIPaymentWebClientService iCICIPaymentWebClientService;
    private final ICICIRetailEncryptionDecryptionUtil iciciRetailEncryptionDecryptionUtil;
    private final TransactionDao transactionDao;
    private final OtherInbConfigDetails otherInbConfigDetails;
    private final OrderDao orderDao;
    private final PaymentCallbackForwardService paymentCallbackForwardService;

    // ==========================================================================
    // 1. Entry point — process web response payload
    // ==========================================================================
    public RedirectView processICICIWebResponsePayload(String webResponse)
            throws InvalidAlgorithmParameterException, IllegalBlockSizeException,
                   NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException,
                   InvalidKeyException {
        try {
            PaymentFinalResponse paymentFinalResponse = processICICICallBack(webResponse);
            logger.info("Payment ICICI callback processed | atrn={} status={}",
                    paymentFinalResponse.getAtrn(), paymentFinalResponse.getTransactionStatus());

            String txnStatus = Optional.ofNullable(paymentFinalResponse.getTransactionStatus())
                    .map(String::toUpperCase)
                    .orElse(OtherInbConstants.EMPTY);

            String lookupStatus = OtherInbConstants.FAILURE_CONST.equalsIgnoreCase(txnStatus)
                    ? OtherInbConstants.FAILED
                    : txnStatus;

            TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(
                    paymentFinalResponse.getAtrn(), lookupStatus);
            if (transactionDto == null) {
                logger.error("No valid transaction for atrn={} status={}",
                        paymentFinalResponse.getAtrn(), lookupStatus);
                throw new OtherInbPaymentException(
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
            }

            Order order = orderDao.getOrderDetails(transactionDto);
            if (order == null) {
                logger.error("Order not found for atrn={}", paymentFinalResponse.getAtrn());
                throw new OtherInbPaymentException(
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
            }

            String callbackPayload = paymentCallbackForwardService
                    .processCallbackResponse(paymentFinalResponse, transactionDto, order);
            if (!StringUtils.hasText(callbackPayload)) {
                logger.error("Empty callback payload for atrn={}",
                        paymentFinalResponse.getAtrn());
                throw new OtherInbPaymentException(
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
            }

            String encoded = Base64.getEncoder()
                    .encodeToString(callbackPayload.getBytes(StandardCharsets.UTF_8));

            RedirectView redirectView = new RedirectView();
            redirectView.setUrl(otherInbConfigDetails.getMerchantResponseView()
                    .concat(OtherInbConstants.MERCHANT_FINAL_RESPONSE)
                    .concat(encoded));

            logger.info("Redirecting user to merchant for atrn={}",
                    paymentFinalResponse.getAtrn());
            return redirectView;

        } catch (OtherInbPaymentException e) {
            throw e;
        } catch (Exception e) {
            logger.error("Unexpected error in processICICIWebResponsePayload", e);
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }
    }

    // ==========================================================================
    // 2. Callback processing
    // ==========================================================================
    public PaymentFinalResponse processICICICallBack(String webResponse)
            throws InvalidAlgorithmParameterException, IllegalBlockSizeException,
                   NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException,
                   InvalidKeyException {

        if (!StringUtils.hasText(webResponse)) {
            logger.error("Received empty ICICI web response");
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }

        // Decrypt outer layer (single-arg call)
        String sanitized = webResponse
                .replaceAll(OtherInbConstants.NEW_LINE_REGEX, OtherInbConstants.PATTERN_EMPTY)
                .replace(OtherInbConstants.PATTERN_SPACE, OtherInbConstants.PATTERN_EMPTY);

        String decryptedWebResponse = Optional.ofNullable(
                        iciciRetailEncryptionDecryptionUtil.iciciDecrypt(sanitized))
                .filter(StringUtils::hasText)
                .orElseThrow(() -> new OtherInbPaymentException(
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                        ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE));

        logger.info("ICICI callback decrypted response={}", decryptedWebResponse);

        // Parse pipe-separated key=value pairs
        Map<String, String> decryptedMap =
                iciciRetailEncryptionDecryptionUtil.getDecryptedData(decryptedWebResponse);

        // Validate required fields / checksum
        otherInbpaymentValidator.validateICICIWebResponse(decryptedMap);

        // Convert Map → DTO (no double-decrypt)
        ICICIResponseDto iciciMapWebResponseDto;
        try {
            iciciMapWebResponseDto = new ObjectMapper()
                    .convertValue(decryptedMap, ICICIResponseDto.class);
        } catch (Exception e) {
            logger.error("Failed to convert ICICI map to DTO", e);
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }
        if (iciciMapWebResponseDto == null) {
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }
        logger.info("ICICI callback mapped DTO={}", iciciMapWebResponseDto);

        // Non-success short-circuit (null-safe)
        if (!OtherInbConstants.ICICI_STATUS_SUCCESS_CONST
                .equalsIgnoreCase(iciciMapWebResponseDto.getPaId())) {
            logger.warn("ICICI callback non-success paId={}",
                    iciciMapWebResponseDto.getPaId());
            return getRedirectObject(iciciMapWebResponseDto);
        }

        // Validate & initiate DV
        ICICIResponseDto callBackResponse = mapCallBackResponse(iciciMapWebResponseDto);
        otherInbpaymentValidator.validateICICIcallBack(callBackResponse);
        iciciDvinitiationProcess(callBackResponse);

        return getRedirectObject(iciciMapWebResponseDto);
    }

    // ==========================================================================
    // 3. DV initiation
    // ==========================================================================
    public PaymentFinalResponse iciciDvinitiationProcess(ICICIResponseDto iciciResponseDto)
            throws InvalidAlgorithmParameterException, IllegalBlockSizeException,
                   NoSuchPaddingException, BadPaddingException, NoSuchAlgorithmException,
                   InvalidKeyException {

        if (iciciResponseDto == null || !StringUtils.hasText(iciciResponseDto.getPrn())) {
            logger.error("iciciDvinitiationProcess called with null/blank prn");
            return getRedirectObject(iciciResponseDto);
        }

        transactionDao.getValidPaymentAckReq(
                iciciResponseDto.getPrn(),
                PaymentStatus.BOOKED.toString(),
                OtherInbConstants.ICICI_CONST);

        switch (Optional.ofNullable(iciciResponseDto.getPaId()).orElse(OtherInbConstants.EMPTY)) {

            case OtherInbConstants.ICICI_STATUS_SUCCESS_CONST -> {
                try {
                    String dvRequestString = iciciRetailEncryptionDecryptionUtil
                            .processICICIDoubleVerRequest1(iciciResponseDto);
                    logger.info("ICICI DV request (plain)={}", dvRequestString);

                    String iciciRawResponse = iCICIPaymentWebClientService
                            .processingDoubleVerRequest(dvRequestString);
                    logger.info("ICICI DV raw response length={}",
                            iciciRawResponse == null ? 0 : iciciRawResponse.length());

                    if (!StringUtils.hasText(iciciRawResponse)) {
                        logger.error("Empty DV response for prn={}",
                                iciciResponseDto.getPrn());
                        return getRedirectObject(iciciResponseDto);
                    }

                    String decryptedDvResponse = URLDecoder.decode(
                            iciciRetailEncryptionDecryptionUtil.iciciDecrypt(
                                    iciciRawResponse.trim()
                                            .replaceAll(OtherInbConstants.NEW_LINE_REGEX,
                                                    OtherInbConstants.PATTERN_EMPTY)
                                            .replace(OtherInbConstants.PATTERN_SPACE,
                                                    OtherInbConstants.PATTERN_EMPTY)),
                            StandardCharsets.UTF_8);
                    logger.info("ICICI DV decrypted response={}", decryptedDvResponse);

                    ICICIDvResponseDto iciciDvResponseDto =
                            convertDvResponsetoDto(decryptedDvResponse);
                    if (iciciDvResponseDto == null) {
                        return getRedirectObject(iciciResponseDto);
                    }

                    // Compare paId (was incorrectly comparing prn)
                    if (!OtherInbConstants.ICICI_STATUS_SUCCESS_CONST
                            .equalsIgnoreCase(iciciDvResponseDto.getPaId())) {
                        logger.warn("ICICI DV non-success paId={} prn={}",
                                iciciDvResponseDto.getPaId(), iciciDvResponseDto.getPrn());
                        ICICIResponseDto failed = ICICIResponseDto.builder()
                                .prn(iciciDvResponseDto.getPrn())
                                .paId(iciciDvResponseDto.getPaId())
                                .atrn(iciciResponseDto.getAtrn())
                                .amount(iciciDvResponseDto.getAmount())
                                .build();
                        return getRedirectObject(failed);
                    }

                    // Use validation result — previously ignored
                    PaymentFinalResponse validationResult =
                            validateCallBackResponse(iciciResponseDto, iciciDvResponseDto);
                    if (validationResult != null) {
                        return validationResult;
                    }

                    // Persist DV response + update status (see TODO in util)
                    ICICIDvResponseDto processed = iciciRetailEncryptionDecryptionUtil
                            .processICICIDoubleVerRequest(iciciResponseDto);
                    logger.info("ICICI DV processed result={}", processed);

                } catch (OtherInbPaymentException e) {
                    throw e;
                } catch (Exception e) {
                    logger.error("Error during ICICI DV initiation for prn={}",
                            iciciResponseDto.getPrn(), e);
                    return getRedirectObject(iciciResponseDto);
                }
            }

            default -> {
                logger.info("ICICI DV skipped — paId={}", iciciResponseDto.getPaId());
                return getRedirectObject(iciciResponseDto);
            }
        }
        return getRedirectObject(iciciResponseDto);
    }

    // ==========================================================================
    // 4. Build redirect/final object
    // ==========================================================================
    public PaymentFinalResponse getRedirectObject(ICICIResponseDto iciciResponseDto) {
        if (iciciResponseDto == null || !StringUtils.hasText(iciciResponseDto.getPrn())) {
            logger.error("getRedirectObject called with null DTO or blank prn");
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }

        String paId = Optional.ofNullable(iciciResponseDto.getPaId())
                .orElse(OtherInbConstants.EMPTY);
        String resolvedStatus = paId.equalsIgnoreCase(OtherInbConstants.ZERO)
                ? OtherInbConstants.SUCCESS
                : OtherInbConstants.FAILED;

        logger.info("Building final response | prn={} status={} channel=ICICI",
                iciciResponseDto.getPrn(), resolvedStatus);

        TransactionDto transactionDto =
                transactionDao.getTransactionDetails(iciciResponseDto.getPrn());
        if (transactionDto == null) {
            logger.error("Transaction not found for prn={}", iciciResponseDto.getPrn());
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }

        Order order = orderDao.getOrderDetails(transactionDto);
        if (order == null) {
            logger.error("Order not found for prn={}", iciciResponseDto.getPrn());
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_CODE,
                    ErrorConstants.ICICI_WEB_RESPONSE_ERROR_MESSAGE);
        }

        FinalResponseStatus finalResponseStatus = getStatus(
                transactionDto, order, resolvedStatus,
                paId.isEmpty() ? OtherInbConstants.EMPTY : paId);

        return PaymentFinalResponse.builder()
                .mId(safe(transactionDto.getMerchantId()))
                .merchantOrderNumber(safe(transactionDto.getOrderRefNumber()))
                .sbiOrderId(safe(transactionDto.getSbiOrderRefNumber()))
                .orderAmount(transactionDto.getOrderAmount() == null
                        ? OtherInbConstants.EMPTY
                        : String.valueOf(transactionDto.getOrderAmount()))
                .totalAmount(transactionDto.getDebitAmt() == null
                        ? OtherInbConstants.EMPTY
                        : String.valueOf(transactionDto.getDebitAmt()))
                .atrn(safe(transactionDto.getAtrnNum()))
                .transactionStatus(finalResponseStatus.getStatus())
                .reason(finalResponseStatus.getResponseReason())
                .CIN(safe(transactionDto.getCin()))
                .otherDetails(safe(order.getOtherDetails()))
                .bankName(safe(transactionDto.getChannelBank()))
                .bankTxnNumber(paId)
                .bankCode(safe(transactionDto.getPayMode()))
                .customerId(safe(order.getCustomerId()))
                .orderRetryCount(order.getOrderRetryCount() == null
                        ? OtherInbConstants.EMPTY
                        : String.valueOf(order.getOrderRetryCount()))
                .build();
    }

    // ==========================================================================
    // 5. Status resolution
    // ==========================================================================
    public FinalResponseStatus getStatus(TransactionDto transactionDto, Order order,
                                         String channelStatus, String failureReason) {
        if (transactionDto == null || order == null) {
            logger.error("getStatus received null transaction/order");
            return FinalResponseStatus.builder()
                    .status(OtherInbConstants.FAILED)
                    .responseReason(OtherInbConstants.FAILED_FOR_AMOUNT_NOT_MATCHED)
                    .build();
        }

        if (!Objects.equals(transactionDto.getOrderAmount(), order.getOrderAmount())) {
            logger.warn("Amount mismatch | txn={} order={}",
                    transactionDto.getOrderAmount(), order.getOrderAmount());
            return FinalResponseStatus.builder()
                    .status(OtherInbConstants.FAILED)
                    .responseReason(OtherInbConstants.FAILED_FOR_AMOUNT_NOT_MATCHED)
                    .build();
        }

        String safeReason = Optional.ofNullable(failureReason)
                .orElse(OtherInbConstants.EMPTY)
                .replaceAll(OtherInbConstants.SPECIAL_CHAR_REGEX, OtherInbConstants.EMPTY);

        return FinalResponseStatus.builder()
                .status(channelStatus)
                .responseReason(safeReason)
                .build();
    }

    // ==========================================================================
    // 6. Map callback response (duplicate setters removed)
    // ==========================================================================
    public ICICIResponseDto mapCallBackResponse(ICICIResponseDto src) {
        if (src == null) {
            return null;
        }
        return ICICIResponseDto.builder()
                .atrn(src.getAtrn())
                .prn(src.getPrn())
                .itc(src.getItc())
                .amount(src.getAmount())
                .crn(src.getCrn())
                .paId(src.getPaId())
                .bId(src.getBId())
                .build();
    }

    // ==========================================================================
    // 7. Validate web vs DV response
    // ==========================================================================
    private PaymentFinalResponse validateCallBackResponse(ICICIResponseDto webDto,
                                                         ICICIDvResponseDto dvDto) {
        if (webDto == null || dvDto == null) {
            logger.warn("validateCallBackResponse called with null arguments");
            return webDto == null ? null : getRedirectObject(webDto);
        }

        if (!otherInbpaymentValidator.validateWebAndDvAmt(
                webDto.getAmount(), dvDto.getAmount())) {
            logger.warn("Web/DV amount mismatch prn={}", webDto.getPrn());
            return getRedirectObject(webDto);
        }

        if (!otherInbpaymentValidator.validateBankReferenceNumber(
                webDto.getPrn(), dvDto.getBId())) {
            logger.warn("Web/DV bank-ref mismatch prn={}", webDto.getPrn());
            return getRedirectObject(webDto);
        }
        return null; // success
    }

    // ==========================================================================
    // 8. DV response → DTO
    // ==========================================================================
    public ICICIDvResponseDto convertDvResponsetoDto(String iciciDvResponse) {
        if (!StringUtils.hasText(iciciDvResponse)) {
            logger.error("Empty DV response received for parsing");
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_DV_RESPONSE_PROCESS_ERROR_CODE,
                    ErrorConstants.ICICI_DV_RESPONSE_PROCESS_MESSAGE);
        }
        logger.info("Parsing ICICI DV response={}", iciciDvResponse);
        try {
            return new ObjectMapper().readValue(iciciDvResponse, ICICIDvResponseDto.class);
        } catch (JsonProcessingException e) {
            logger.error("Failed to parse ICICI DV response", e);
            throw new OtherInbPaymentException(
                    ErrorConstants.ICICI_DV_RESPONSE_PROCESS_ERROR_CODE,
                    ErrorConstants.ICICI_DV_RESPONSE_PROCESS_MESSAGE);
        }
    }

    // ---- helpers ----
    private String safe(String v) {
        return StringUtils.hasText(v) ? v : OtherInbConstants.EMPTY;
    }
}
