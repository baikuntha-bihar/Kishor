        otherInbPaymentDao.saveRequestLog(planeTextWebReqData, paymentWebRequest.getAtrn(),
                OtherInbConstants.WEB_REQUEST_TYPE, OtherInbConstants.CREATED_BY_ICICI);
        otherInbPaymentDao.saveRequestLog(planeTextWebReqData, paymentWebRequest.getAtrn(),
