        logger.info("dateTimeString. {} for ICICI Bank ", txnDateTime);

        String planeTextWebReqData = createWebRequest(transactionDto, otherInbChannelUnitMappingDto, txnDateTime);
        logger.info("planeTextWebReqData. {} for  ICICI Bank ", planeTextWebReqData);

