                String.valueOf(otherInbChannelUnitMappingDto.getWebRequestFormat()),
                transactionDto.getAtrnNum(), "MSEDCL", transactionDto.getDebitAmt(),
                transactionDto.getCurrencyCode(),
                otherInbChannelUnitMappingDto.getChannelReturnUrl(), "Y");
    }

    public PostingData encryptedPostedData(String planeTextWebReqData,
                                           OtherInbChannelUnitMappingDto otherInbChannelUnitMappingDto,
                                           TransactionDto transactionDto) throws Exception {
        // Kept as-is — manual instance uses the same 16-char key.
        String encWebReqData = new ICICIRetailEncryptionDecryptionUtil("uxowYdKK3so2w6Ad")
                .iciciEncrypt(planeTextWebReqData);
        return PostingData.builder().data(encWebReqData).build();
    }

    // ------------------------------------------------------------------
    // FIX #2 + #4 (compile error + NPE guard):
    //   sun.misc.BASE64Encoder -> java.util.Base64.getEncoder()
    //   Output is identical: original strips \n/\r right after anyway.
    // ------------------------------------------------------------------
    public String iciciEncrypt(String stringToEncrypt)
            throws InvalidKeyException, IllegalStateException,
                   IllegalBlockSizeException, BadPaddingException {

        // ADDED: null guard (prevents NPE from caller)
        if (stringToEncrypt == null) {
            throw new IllegalArgumentException("stringToEncrypt must not be null");
        }

        c.init(1, encryptDecryptKey);
        String sEncString = Base64.getEncoder()
                .encodeToString(c.doFinal(stringToEncrypt.getBytes()));
        sEncString = sEncString.replaceAll("\n", "");
        sEncString = sEncString.replaceAll("\r", "");
        return sEncString;
    }

    // ------------------------------------------------------------------
    // FIX #3 + #4 (compile error + NPE guard):
    //   sun.misc.BASE64Decoder -> java.util.Base64.getMimeDecoder()
    //   getMimeDecoder() tolerates \n/\r exactly like the original
    //   BASE64Decoder.decodeBuffer() did.
    // ------------------------------------------------------------------
    public String iciciDecrypt(String stringToDecrypt)
            throws InvalidKeyException, IOException, IllegalStateException,
                   IllegalBlockSizeException, BadPaddingException {

        // ADDED: null guard
        if (stringToDecrypt == null) {
            throw new IllegalArgumentException("stringToDecrypt must not be null");
        }

        c.init(2, encryptDecryptKey);
        byte[] cleartext = Base64.getMimeDecoder()
                .decode(this.replaceSpecialChars(stringToDecrypt));
        byte[] ciphertext = c.doFinal(cleartext);
        return this.bytes2String(ciphertext);
    }

    private String bytes2String(byte[] bytes) {
        // UNCHANGED
        StringBuffer stringBuffer = new StringBuffer();
        for (int i = 0; i < bytes.length; ++i) {
            stringBuffer.append((char) bytes[i]);
        }
        return stringBuffer.toString();
    }

    private String replaceSpecialChars(String str) {
        // UNCHANGED
        StringBuffer sb = new StringBuffer();
        for (int i = 0; i < str.length(); ++i) {
            if (str.charAt(i) == ' ') {
                sb.append('+');
            } else {
                sb.append(str.charAt(i));
            }
        }
        return sb.toString();
    }

