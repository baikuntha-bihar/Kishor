    // ------------------------------------------------------------------
    // FIX #1 (runtime NPE):
    //   Original had @RequiredArgsConstructor on the class + this explicit
    //   (String) ctor. Lombok generated a no-arg ctor; Spring preferred it;
    //   static encryptDecryptKey / c stayed null -> NPE on first encrypt.
    //
    //   Fix: removed @RequiredArgsConstructor, added @Autowired here, and
    //   @Value falls back to the SAME original key so encryption output
    //   is byte-for-byte unchanged.
    //
    //   NOTE: `new ICICIRetailEncryptionDecryptionUtil("uxowYdKK3so2w6Ad")`
    //   inside encryptedPostedData() still works — @Autowired only
    //   affects Spring's behaviour, not manual instantiation.
    // ------------------------------------------------------------------
    @Autowired
    public ICICIRetailEncryptionDecryptionUtil(
            @Value("${icici.master.key:uxowYdKK3so2w6Ad}") String sMasterKey)
            throws NoSuchAlgorithmException, NoSuchPaddingException, InvalidKeyException {

        String sKey = "";
        String sAlgorithm = "AES";
        sKey = sMasterKey.trim();
        if (sKey.length() != 16) {
            throw new InvalidKeyException("Master Key should be of 16 Characters");
        } else {
            byte[] sKeyBytes = sKey.getBytes();
            encryptDecryptKey = (Key) (new SecretKeySpec(sKeyBytes, sAlgorithm));
            c = Cipher.getInstance(sAlgorithm);
        }
    }

    // WEB REQUEST INITIATION METHOD FOR ICICI BANK
    public OtherInbPostingData processInitiate(PaymentRequest paymentWebRequest,
