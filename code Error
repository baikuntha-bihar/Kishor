package com.epay.otherinb.externalservice;

import com.epay.otherinb.config.OtherInbConfigDetails;
import com.epay.otherinb.exceptions.OtherInbPaymentException;
import com.epay.otherinb.util.constants.ErrorConstants;
import com.epay.otherinb.util.constants.OtherInbConstants;
import com.epay.otherinb.util.encryptdecryptutil.ICICIRetailEncryptionDecryptionUtil;
import com.sbi.epay.logging.utility.LoggerFactoryUtility;
import com.sbi.epay.logging.utility.LoggerUtility;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Component;
import org.springframework.util.StringUtils;
import org.springframework.web.reactive.function.client.WebClient;
import reactor.core.publisher.Mono;
import reactor.util.retry.Retry;

import java.text.MessageFormat;
import java.time.Duration;
import java.util.Optional;

@Component
@RequiredArgsConstructor
public class ICICIPaymentWebClientService {

    private final LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final OtherInbConfigDetails otherInbConfigDetails;
    private final ICICIRetailEncryptionDecryptionUtil iciciRetailEncryptionDecryptionUtil;

    public String processingDoubleVerRequest(String plainDvRequestAndChecksum) {
        try {
            // W1, W2: was decrypt (wrong). Now encrypt — no IOException needed
            String encryptedDVData =
                    iciciRetailEncryptionDecryptionUtil.iciciEncrypt(plainDvRequestAndChecksum);
            logger.info("Payment Callback Encrypted and Encoded Double Verification {} ",
                    encryptedDVData);

            // W3: safe null check (no NPE)
            String DVResponse = Optional.ofNullable(ICICIDVResponseConn(
                            otherInbConfigDetails.getMerchantResponseView(),
                            (OtherInbConstants.ICICI_MERCH_CODE_CONST_URL)
                                    .concat("mid")
                                    .concat(OtherInbConstants.ICICI_ENC_DATA)
                                    .concat(encryptedDVData)))
                    .filter(StringUtils::hasText)
                    .orElseThrow(() -> new OtherInbPaymentException(
                            ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE,
                            ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE));

            logger.info("Payment Callback Encrypted Double Verification Response {} ", DVResponse);
            return DVResponse;
        } catch (OtherInbPaymentException e) {
            throw e;
        } catch (Exception e) {
            logger.error("Exception While processingDoubleVerRequest  {}", e);
            throw new OtherInbPaymentException(
                    ErrorConstants.DOUBLE_VERIFICATION_ERROR_CODE,
                    ErrorConstants.DOUBLE_VERIFICATION_ERROR_MESSAGE);
        }
    }

    // Preserved original method name (uppercase) to avoid touching callers
    public String ICICIDVResponseConn(String bankdvurl, String encryptedData) {
        logger.info("Other INB DV Request posting parameters DV Url {} and encryptedData {} ",
                bankdvurl, encryptedData);
        try {
            WebClient webClient = WebClient.builder().baseUrl(bankdvurl).build();
            logger.info("webClient URL for other INB {} ", bankdvurl);

            return webClient.post()
                    .header(OtherInbConstants.REQUESTPROPERTY,
                            OtherInbConstants.URL_ENCODED_CONTENT_TYPE)
                    .bodyValue(encryptedData)
                    .retrieve()
                    .onStatus(status -> !status.is2xxSuccessful(),
                            clientResponse -> clientResponse.bodyToMono(String.class)
                                    .flatMap(errorBody -> Mono.error(
                                            new OtherInbPaymentException(
                                                    ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                                                    MessageFormat.format(
                                                            ErrorConstants.EXTERNAL_SERVICE_ERROR_MESSAGE,
                                                            OtherInbConstants.SBI_INB_SERVICE)))))
                    .bodyToMono(String.class)
                    .doOnNext(body -> logger.info("responseCode for other INB {} ", body))
                    .doOnError(error -> logger.info("error responseCode for other INB {} ", error))
                    .onErrorResume(error -> {
                        logger.info("error responseCode for other INB {} ", error);
                        return Mono.error(() -> new OtherInbPaymentException(
                                ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                                MessageFormat.format(
                                        ErrorConstants.EXTERNAL_SERVICE_ERROR_MESSAGE,
                                        OtherInbConstants.OTHER_INB_SERVICE)));
                    })
                    .retryWhen(Retry.fixedDelay(3, Duration.ofSeconds(1))
                            .filter(t -> t instanceof OtherInbPaymentException)
                            .doBeforeRetry(rs -> logger.info(
                                    "Retrying attempt {} due to error: {}",
                                    rs.totalRetries() + 1,
                                    rs.failure().getMessage())))
                    .block();
        } catch (Exception e) {
            logger.error("Exception While otherINBDVResponseConn  {}", e);
            throw new OtherInbPaymentException(
                    ErrorConstants.EXTERNAL_SERVICE_ERROR_CODE,
                    MessageFormat.format(
                            ErrorConstants.EXTERNAL_SERVICE_ERROR_MESSAGE,
                            OtherInbConstants.OTHER_INB_SERVICE));
        }
    }
}


