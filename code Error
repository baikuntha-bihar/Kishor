    public String formatedAmount(BigDecimal amount) {
        if (amount == null) {
            return OtherInbConstants.EMPTY;
        }
        BigDecimal converted = amount.setScale(2, RoundingMode.UP);
        return new DecimalFormat("0.00").format(converted);
