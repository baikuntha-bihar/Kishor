        if ( StringUtils.isNotBlank(value) && !value.equals(value.trim())) {
            addError(fieldName, CashChallanErrorConstants.TRAILING_SPACES_ERROR_CODE, CashChallanErrorConstants.TRAILING_SPACES_ERROR_MESSAGE);
        }
