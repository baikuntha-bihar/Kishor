        OrderInfo orderInfo = OrderInfo.builder().sbiOrderId(paymentFinalResponse.getSbiOrderId() == null ? PaymentConstants.EMPTY : paymentFinalResponse.getSbiOrderId())
                .orderRefNumber(paymentFinalResponse.getMerchantOrderNumber() == null ? PaymentConstants.EMPTY : paymentFinalResponse.getMerchantOrderNumber())
                .orderStatus(String.valueOf(order.getStatus()) == null ? PaymentConstants.EMPTY : String.valueOf(order.getStatus()))
                .currencyCode(transactionDto.getCurrencyCode() == null ? PaymentConstants.EMPTY : transactionDto.getCurrencyCode())
                .otherDetails(paymentFinalResponse.getOtherDetails() == null ? PaymentConstants.EMPTY : paymentFinalResponse.getOtherDetails())
                .build();

        PaymentInfo paymentInfo = PaymentInfo.builder().atrnNumber(paymentFinalResponse.getAtrn() == null ? PaymentConstants.EMPTY : paymentFinalResponse.getAtrn())
                .orderAmount(transactionDto.getOrderAmount() == null ? new BigDecimal(PaymentConstants.ZERO) : transactionDto.getOrderAmount())
                .totalAmount(transactionDto.getDebitAmt() == null ? new BigDecimal(PaymentConstants.ZERO) : transactionDto.getDebitAmt())
                .transactionStatus(transactionDto.getTransactionStatus() == null ? PaymentConstants.EMPTY : String.valueOf(transactionDto.getTransactionStatus()))
                .payMode(transactionDto.getPayMode() == null ? PaymentConstants.EMPTY : transactionDto.getPayMode())
                .bankName(paymentFinalResponse.getBankName() == null ? PaymentConstants.EMPTY : paymentFinalResponse.getBankName())
                .bankTxnNumber(transactionDto.getBankReferenceNumber() == null ? PaymentConstants.EMPTY : transactionDto.getBankReferenceNumber())
                .currencyCode(transactionDto.getCurrencyCode() == null ? PaymentConstants.EMPTY : transactionDto.getCurrencyCode())
                .transactionTime(String.valueOf(transactionDto.getCreatedDate()) == null ? PaymentConstants.EMPTY : String.valueOf(transactionDto.getCreatedDate()))
                .CIN(transactionDto.getCin() == null ? PaymentConstants.EMPTY : transactionDto.getCin())
                .build();
        PaymentStatusResponse paymentStatusResponseJsonString = PaymentStatusResponse.builder().orderInfo(orderInfo).paymentInfo(paymentInfo).build();

        List<PaymentStatusResponse> obj= new ArrayList<>();
        obj.add(paymentStatusResponseJsonString);
        logger.info("Plain FinalResponse For Posting to UI. {}",PaymentUtil.toJson(obj));

        String encryptedFinalResponse = encryptValue(mek, PaymentUtil.toJson(obj));
        logger.info("encryptedFinalResponse For Posting to UI. {}",encryptedFinalResponse);
        //Create JsonArray End...

        logger.info("Payment callback Start encryptedFinalResponse {} ", encryptedFinalResponse);
        return encryptedFinalResponse;
    }


}

