@Component
@RequiredArgsConstructor
public class NbPaymentDao {

    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());
    private final PaymentDao paymentDao;
    private final InbEncryptionDecryptionUtil inbEncryptionDecryptionUtil;
    private final PaymentValidator paymentValidator;
    private final StatusUpdatePaymentDao statusUpdatePaymentDao;

    /**
     * @return -JSON : Web or DV Status and ATRN.
     * @methodName: Process Web Response Payload.
     * @@Method-Description: Switch case when webResponse success or pending else fail.
     * @param: processNbDoubleVerRequest
     * @Exception or @Error :Exception
     */

    public String processInbDoubleVerRequest(NbMapWebResponseDto nbMapWebResponseDto) {
        return getCallBackResponse(nbMapWebResponseDto.getTxnrefNo(),nbMapWebResponseDto.getAmount());
    }

    public NbMapWebResponseDto processNbDoubleVerRequest(NbMapWebResponseDto nbMapWebResponseDto, NbMapWebResponseDto nbMapDVResponseDto, String inbDvResponse) {
        //Save DV Response in DB
        paymentDao.saveResponseLog(inbDvResponse, nbMapDVResponseDto.getTxnrefNo(), nbMapDVResponseDto.getSbirefNo(), PaymentConstants.DV_RESPONSE_TYPE, PaymentConstants.CREATED_BY);
        // Validation call checksum, bank ref number, amount
                validateCallBackResponse(nbMapWebResponseDto, nbMapDVResponseDto, inbDvResponse); // Check Method...
        //in web or dv response trace no is null or zero then mark txn as fail.
                switch (nbMapDVResponseDto.getStatus()) {
                    case PaymentConstants.SUCCESS_CONST -> {
                        logger.info("Payment Callback DV SBI-INB SUCCESS_CONST {} " , nbMapDVResponseDto);
                        statusUpdatePaymentDao.paymentSuccessPendingStatusUpdateGen(PaymentStatus.SUCCESS.toString(), nbMapDVResponseDto.getTxnrefNo(),  nbMapDVResponseDto.getSbirefNo(),PaymentConstants.SBI_NET_BANKING,PaymentConstants.NB_CONST);
                        return nbMapDVResponseDto;
                    }
                    case PaymentConstants.PENDING_CONST -> {
                        logger.info("Payment Callback DV SBI-INB PENDING_CONST {} " , nbMapDVResponseDto);
                        statusUpdatePaymentDao.paymentSuccessPendingStatusUpdateGen(PaymentStatus.PENDING.toString(), nbMapDVResponseDto.getTxnrefNo(),  nbMapDVResponseDto.getSbirefNo(),PaymentConstants.SBI_NET_BANKING,PaymentConstants.NB_CONST);
                        return nbMapDVResponseDto;
                    }
                    case PaymentConstants.FAILURE_CONST -> {
                        logger.info("Payment Callback DV SBI-INB FAILURE_CONST {} " , nbMapDVResponseDto);
                        statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapDVResponseDto.getTxnrefNo(),nbMapDVResponseDto.getSbirefNo(),nbMapDVResponseDto.getStatus_desc(),PaymentConstants.SBI_NET_BANKING);
                        return nbMapDVResponseDto;
                    }
                    default -> {
                        logger.info("Payment Callback DV SBI-INB default {} " , nbMapDVResponseDto);
                        statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapDVResponseDto.getTxnrefNo(),nbMapDVResponseDto.getSbirefNo(),nbMapDVResponseDto.getStatus_desc(),PaymentConstants.SBI_NET_BANKING);
                        return nbMapDVResponseDto;
                    }
                }
        }

private String getCallBackResponse(String txnRefNo, BigDecimal amount){
    // Create DV request and checksum.
    String plainDvRequestAndChecksum  = MessageFormat.format(PaymentConstants.SBIINB_DV_REQUEST,txnRefNo,amount.toString().replaceAll(PaymentConstants.COMMA,PaymentConstants.EMPTY)).concat(PaymentConstants.SBIINB_CHECKSUM).concat(inbEncryptionDecryptionUtil.getSHA2Checksum(MessageFormat.format(PaymentConstants.SBIINB_DV_REQUEST,txnRefNo,amount.toString().replaceAll(PaymentConstants.COMMA,PaymentConstants.EMPTY))));
    logger.info("Payment Callback Plain Double Verification Request and Checksum {} " + plainDvRequestAndChecksum);
    // Save DV Request...
    paymentDao.saveRequestLog(plainDvRequestAndChecksum,txnRefNo,PaymentConstants.DV_REQUEST_TYPE,PaymentConstants.CREATED_BY);
    return plainDvRequestAndChecksum;
    }

    private void validateCallBackResponse(NbMapWebResponseDto nbMapWebResponseDto, NbMapWebResponseDto nbMapDVResponseDto, String inbDvResponse){
        String plainDVCheckSumStr = (inbDvResponse.lastIndexOf(PaymentConstants.PIPE) != -1 ) ?  inbDvResponse.substring(0,inbDvResponse.lastIndexOf(PaymentConstants.PIPE)) : inbDvResponse;
        logger.info("DV Payment Callback Decrypted Web Response plainCheckSumStr {} ", plainDVCheckSumStr);

        logger.info("SBI INB DV Bank Created CheckSum String: {}, SBIePay Created Checksum string: {} ",nbMapDVResponseDto.getCheckSum(),inbEncryptionDecryptionUtil.getSHA2Checksum(plainDVCheckSumStr));

        if (!paymentValidator.checkSum(nbMapDVResponseDto.getCheckSum(), inbEncryptionDecryptionUtil.getSHA2Checksum(plainDVCheckSumStr))) {
            statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapWebResponseDto.getTxnrefNo(),nbMapWebResponseDto.getSbirefNo(), InbErrorConstants.DV_CHECKSUM_MISMATCH_ERROR_MESSAGE,PaymentConstants.SBI_NET_BANKING);
            throw new PaymentException(InbErrorConstants.DV_CHECKSUM_ERROR_CODE, InbErrorConstants.DV_CHECKSUM_MISMATCH_ERROR_MESSAGE);
        }

        if (!paymentValidator.validateWebAndDvAmt(nbMapWebResponseDto.getAmount(), nbMapDVResponseDto.getAmount())) {
            statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapWebResponseDto.getTxnrefNo(),nbMapWebResponseDto.getSbirefNo(), InbErrorConstants.AMOUNT_ERROR_MESSAGE,PaymentConstants.SBI_NET_BANKING);
            throw new PaymentException(InbErrorConstants.AMOUNT_ERROR_CODE, InbErrorConstants.AMOUNT_ERROR_MESSAGE);
        }
        if (!paymentValidator.ValidateBankReferenceNumber(nbMapWebResponseDto.getSbirefNo(), nbMapDVResponseDto.getSbirefNo())) {
            statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapWebResponseDto.getTxnrefNo(),nbMapWebResponseDto.getSbirefNo(), InbErrorConstants.BANK_REF_NO_ERROR_MESSAGE,PaymentConstants.SBI_NET_BANKING);
            throw new PaymentException(InbErrorConstants.BANK_REF_NO_ERROR_CODE, InbErrorConstants.BANK_REF_NO_ERROR_MESSAGE);
        }
    }
}
