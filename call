        validateFieldWithRegex(paymentInitiationRequest.getAtrn(), PaymentConstants.ATRN_ARRN_REGEX_DIGIT, PaymentConstants.ATRN_CONST, PaymentConstants.INVALID_ATRN_CONST);
    }

    //INB end Request Validation

