        checkForLeadingTrailingAndSingleSpace(String.valueOf(nbCallBackResponse.getAmount()), PaymentConstants.AMOUNT);
        checkForLeadingTrailingAndSingleSpace(nbCallBackResponse.getTxnrefNo(), PaymentConstants.TXN_REF_NO);
        checkForLeadingTrailingAndSingleSpace(nbCallBackResponse.getStatus(), PaymentConstants.STATUS);
        checkForLeadingTrailingAndSingleSpace(nbCallBackResponse.getCheckSum(), PaymentConstants.CHECKSUM_CONST);

        validateFieldWithRegex(nbCallBackResponse.getTxnrefNo(), PaymentConstants.ATRN_ARRN_REGEX_DIGIT_CONST, PaymentConstants.ATRN_CONST,PaymentConstants.INVALID_ATRN_CONST);

        validateFieldLength(nbCallBackResponse.getTxnrefNo(), ATRN_LENGTH, PaymentConstants.ATRN_CONST);
        validateFieldLengthMax(nbCallBackResponse.getSbirefNo(), SBI_REF_NO_LENGTH, PaymentConstants.SBI_REF_NO);
        validateFieldLengthMax(nbCallBackResponse.getStatus(), STATUS_LENGTH, PaymentConstants.STATUS);
        validateFieldLengthMax(nbCallBackResponse.getStatus_desc(), STATUS_DESC_LENGTH, PaymentConstants.STATUS_DESC);
        validateFieldLengthMax(nbCallBackResponse.getCheckSum(), CHECKSUM_LENGTH, PaymentConstants.CHECKSUM_CONST);

        validateFieldWithRegex(nbCallBackResponse.getSbirefNo(), PaymentConstants.SBI_REF_NO_REGEX, PaymentConstants.SBI_REF_NO,PaymentConstants.INVALID_SBI_REF_NO_FORMAT);
        validateAmount(new BigDecimal(String.valueOf(nbCallBackResponse.getAmount())), PaymentConstants.AMOUNT_CONST);
        validateFieldWithRegex(nbCallBackResponse.getStatus(), PaymentConstants.SBI_INB_STATUS_REGEX, PaymentConstants.STATUS,PaymentConstants.INVALID_TXN_STATUS_FORMAT);
        validateFieldWithRegex(nbCallBackResponse.getStatus_desc(), PaymentConstants.SBI_INB_STATUS_DESC_REGEX, PaymentConstants.STATUS_DESC,PaymentConstants.INVALID_TXN_STATUS_DESC_FORMAT);

        validateRefNoWithStatusRegex(nbCallBackResponse.getStatus(),nbCallBackResponse.getSbirefNo(),PaymentConstants.SBI_REF_NO);
    }

    //INB Callback validation End

    // Other INB callback validation Start
    public void validateOtherInbCallBack(OtherInbMapResponseDto otherInbCallBackResponse) {

        errorDtoList.clear();
        validateFieldWithRegex(String.valueOf(otherInbCallBackResponse.getAmount()), PaymentConstants.AMOUNT_REGEX, PaymentConstants.AMOUNT, PaymentConstants.INVALID_TXN_AMT_FORMAT);
    }

    // Other INB callback validation End
}
