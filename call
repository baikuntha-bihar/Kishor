    /**
     * @return -JSON : PaymentResponse<PostingData> (1.postURL, 2.data, 3.Key, 4.merchantCode)
     * @methodName: Generate Web Request Payload.
     * @@Method-Description: The purpose of this method is to create web request and encrypt request.
     * @param: generateReqPayload
     * @Exception or @Error :Exception
     */
    public PaymentResponse<PostingData> generateReqPayload(PaymentRequest paymentWebRequest) {
        PaymentInitiationRequest paymentInitiationRequest=getInitiationRequest(paymentWebRequest);
        // Validated PaymentRequest for INB..
        paymentInbValidator.validateNBRequest(paymentInitiationRequest);
        logger.info("Payment Initiation Start for Atrn {} ", paymentWebRequest.getAtrn());
        TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(paymentWebRequest.getAtrn(), PaymentStatus.BOOKED.toString(),PaymentConstants.NB_CONST);
        logger.info("Payment Initiation get atrn details {} ", transactionDto);
        paymentValidator.validateDebitAmount(transactionDto.getDebitAmt());
        String  planeTextWebReqData = paymentUtil.createWebRequest(paymentWebRequest.getAtrn(), transactionDto.getDebitAmt());
        logger.info("Payment Initiation Plane Text Web Request {} , and ATRN {}", planeTextWebReqData,paymentWebRequest.getAtrn());
        paymentDao.saveRequestLog(planeTextWebReqData,paymentWebRequest.getAtrn(), PaymentConstants.WEB_REQUEST_TYPE,PaymentConstants.CREATED_BY);
        PostingData encryptedPostedData = inbEncryptionDecryptionUtil.encryptedPostedData(planeTextWebReqData,paymentWebRequest.getAtrn(),transactionDto.getGatewayIssueMECode());
        logger.info("Payment Initiation Encrypted Web Request {} , and ATRN {}", encryptedPostedData.getData(),paymentWebRequest.getAtrn());
        return PaymentResponse.<PostingData>builder().status(PaymentConstants.API_RESPONSE_STATUS_SUCCESS).data(List.of(encryptedPostedData)).build();
    }

    /**
     * @return -JSON : PaymentFinalResponse
     * @methodName: Process Web Response Payload.
     * @@Method-Description: The purpose of this method is to Process Web Response Payload.
     * @param: processWebResponsePayload
     * @Exception or @Error :Exception
     */
    public RedirectView processWebResponsePayload(String webResponse) {
        logger.info("Payment Callback Encrypted Web Response {} ", webResponse);
        PaymentFinalResponse paymentFinalResponse = processInbCallBack(webResponse);
        logger.info("Payment SBI Inb final response to transaction service paymentFinalResponse {} ", paymentFinalResponse);
        TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(paymentFinalResponse.getAtrn(), paymentFinalResponse.getTransactionStatus().toUpperCase().equalsIgnoreCase(PaymentConstants.FAILURE_CONST) ? PaymentConstants.FAILED : paymentFinalResponse.getTransactionStatus().toUpperCase());
        RedirectView redirectView = new RedirectView();
        redirectView.setUrl((paymentCallbackForwardService.getRedirectionUrl(transactionDto)).concat(PaymentConstants.MERCHANT_FINAL_RESPONSE).concat(Base64.getEncoder().encodeToString(paymentCallbackForwardService.processCallbackResponse(paymentFinalResponse,transactionDto,orderDao.getOrderDetails(transactionDto)).getBytes())));
        return redirectView;
    }

    public PaymentFinalResponse processInbCallBack(String webResponse) {
        logger.info("Payment Callback Encrypted Web Response for SBI INB {} ", webResponse);
        // Decrypt Web response
        String  decryptedWebResponse= Optional.ofNullable(inbEncryptionDecryptionUtil.decrypt(webResponse.replaceAll(PaymentConstants.NEW_LINE_REGEX, PaymentConstants.PATTERN_EMPTY).replace(PaymentConstants.PATTERN_SPACE,PaymentConstants.PATTERN_EMPTY))).filter(x->!x.isEmpty()).orElseThrow(()->new PaymentException(InbErrorConstants.WEB_RESPONSE_ERROR_CODE, InbErrorConstants.WEB_RESPONSE_ERROR_MESSAGE));
        logger.info("Payment Callback Decrypted Web Response {} ", decryptedWebResponse);
        // Check Request Parameters.
        if (!paymentValidator.checkResponseParamData(decryptedWebResponse))
            throw new PaymentException(InbErrorConstants.WEB_CHECKSUM_ERROR_CODE, InbErrorConstants.WEB_CHECKSUM_MISMATCH_ERROR_MESSAGE);
        //Check Amount Validation.
        getData(paymentUtil.getDecryptedData(decryptedWebResponse));
        // Create web response DTO.
        NbMapWebResponseDto nbMapWebResponseDto = Optional.ofNullable(new ObjectMapper().convertValue(paymentUtil.getDecryptedData(decryptedWebResponse), NbMapWebResponseDto.class)).orElseThrow(() ->new PaymentException(InbErrorConstants.WEB_CHECKSUM_ERROR_CODE, InbErrorConstants.WEB_CHECKSUM_MISMATCH_ERROR_MESSAGE));
        logger.info("Payment Callback Decrypted Web Response nbMapWebResponseDto {} ", nbMapWebResponseDto);
        // Save Web response in DB
        paymentDao.saveResponseLog(decryptedWebResponse,nbMapWebResponseDto.getTxnrefNo(),nbMapWebResponseDto.getSbirefNo(),PaymentConstants.WEB_RESPONSE_TYPE,PaymentConstants.CREATED_BY);
        // Check Web Checksum with created checksum.
        String plainCheckSumStr = (decryptedWebResponse.lastIndexOf(PaymentConstants.PIPE) != -1 ) ?  decryptedWebResponse.substring(0,decryptedWebResponse.lastIndexOf(PaymentConstants.PIPE)) : decryptedWebResponse;
        logger.info("Payment Callback Decrypted Web Response plain CheckSum String {} ", plainCheckSumStr);
        logger.info("SBI INB Web Bank Created CheckSum String: {}, SBIePay Created Checksum string: {} ", nbMapWebResponseDto.getCheckSum(),inbEncryptionDecryptionUtil.getSHA2Checksum(plainCheckSumStr));
        if (!paymentValidator.checkSum(nbMapWebResponseDto.getCheckSum() , (inbEncryptionDecryptionUtil.getSHA2Checksum(plainCheckSumStr)))){
            statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapWebResponseDto.getTxnrefNo(), nbMapWebResponseDto.getSbirefNo(), nbMapWebResponseDto.getStatus(), PaymentConstants.SBI_NET_BANKING);
            throw new PaymentException(InbErrorConstants.WEB_CHECKSUM_ERROR_CODE, InbErrorConstants.WEB_CHECKSUM_MISMATCH_ERROR_MESSAGE);
        }

        // Validated PaymentResponse for INB
        NbMapWebResponseDto callBackResponse=getCallBackResponse(nbMapWebResponseDto);
        paymentInbValidator.validateNBCallBack(callBackResponse);
        // atrn txn status is BOOKED and payment status is PAYMENT_INITIATION_START / amount Validation
        TransactionDto transactionDto = transactionDao.getValidPaymentAckReq(nbMapWebResponseDto.getTxnrefNo(), PaymentStatus.BOOKED.toString(),PaymentConstants.NB_CONST);
        paymentValidator.validateDebitAmount(nbMapWebResponseDto.getAmount());
        // Validation for Bank Ref Number.
        if (!paymentValidator.ValidateWebResponseBankReferenceNumber(nbMapWebResponseDto.getSbirefNo())) {
            statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapWebResponseDto.getTxnrefNo(),nbMapWebResponseDto.getSbirefNo(), InbErrorConstants.BANK_REF_NO_ERROR_MESSAGE,PaymentConstants.SBI_NET_BANKING);
            throw new PaymentException(InbErrorConstants.BANK_REF_NO_ERROR_CODE, InbErrorConstants.BANK_REF_NO_ERROR_MESSAGE);
        }
        switch (nbMapWebResponseDto.getStatus()) {
            case PaymentConstants.SUCCESS_CONST, PaymentConstants.PENDING_CONST -> {
                String dvRequestString = nbPaymentDao.processInbDoubleVerRequest(nbMapWebResponseDto);
                logger.info("Payment Callback Plan DV Request for SBIINB {} " + dvRequestString);

                String inbDvResponse = paymentWebClientService.processingDoubleVerRequest(dvRequestString,transactionDto.getGatewayIssueMECode());
                logger.info("Payment Callback Plan DV Response for SBIINB {} " + inbDvResponse);

                NbMapWebResponseDto nbMapDVResponseDto = new ObjectMapper().convertValue(paymentUtil.getDecryptedData(inbDvResponse.trim()), NbMapWebResponseDto.class);
                logger.info("Payment Callback nbMapDVResponseDto for SBIINB {} " + nbMapDVResponseDto);

                nbMapWebResponseDto = nbPaymentDao.processNbDoubleVerRequest(nbMapWebResponseDto,nbMapDVResponseDto,inbDvResponse);
                logger.info("Payment Callback nbMapWebResponseDto for SBIINB {} ",nbMapWebResponseDto);
            }
            default -> {
                statusUpdatePaymentDao.paymentFailureStatusUpdate(nbMapWebResponseDto.getTxnrefNo(), nbMapWebResponseDto.getSbirefNo(), nbMapWebResponseDto.getStatus_desc(), PaymentConstants.SBI_NET_BANKING);
                logger.info("default Payment Callback nbMapWebResponseDto for SBIINB {} ",getRedirectObject(nbMapWebResponseDto));
                return getRedirectObject(nbMapWebResponseDto);
            }
        }
        //Redirecting to Browser.
        return getRedirectObject(nbMapWebResponseDto);
    }

    /**
     * @return: PaymentFinalResponse
     * @methodName: getRedirectObject
     * @@Method-Description: Process setting response data
     * @param: TransactionDto,Status
     * @Exception: or @Error :Exception
     */
    public PaymentFinalResponse getRedirectObject(NbMapWebResponseDto nbMapWebResponseDto) {
        TransactionDto transactionDto = transactionDao.getTransactionDetails(nbMapWebResponseDto.getTxnrefNo());
        Order order = orderDao.getOrderDetails(transactionDto);
        FinalResponseStatus finalResponseStatus=getStatus(transactionDto,order,nbMapWebResponseDto.getStatus() == null ? PaymentConstants.EMPTY : nbMapWebResponseDto.getStatus(),nbMapWebResponseDto.getStatus_desc() == null ? PaymentConstants.EMPTY : nbMapWebResponseDto.getStatus_desc());

        return PaymentFinalResponse.builder()
                .mId(transactionDto.getMerchantId() == null ? PaymentConstants.EMPTY : transactionDto.getMerchantId())
                .merchantOrderNumber(transactionDto.getOrderRefNumber()  == null ? PaymentConstants.EMPTY : transactionDto.getOrderRefNumber())
                .sbiOrderId(transactionDto.getSbiOrderRefNumber() == null ? PaymentConstants.EMPTY : transactionDto.getSbiOrderRefNumber())
                .orderAmount(String.valueOf(transactionDto.getOrderAmount()== null ? PaymentConstants.EMPTY : String.valueOf(transactionDto.getOrderAmount())))
                .totalAmount(String.valueOf(transactionDto.getDebitAmt()) == null ? PaymentConstants.EMPTY : String.valueOf(transactionDto.getDebitAmt()))
                .atrn(transactionDto.getAtrnNum() == null ? PaymentConstants.EMPTY : transactionDto.getAtrnNum())
                .transactionStatus(finalResponseStatus.getStatus())
                .reason(finalResponseStatus.getResponseReason())
                .CIN(transactionDto.getCin() == null ? PaymentConstants.EMPTY : transactionDto.getCin())
                .otherDetails(order.getOtherDetails() == null ? PaymentConstants.EMPTY : order.getOtherDetails())
                .bankName(transactionDto.getChannelBank() == null ? PaymentConstants.EMPTY : transactionDto.getChannelBank())
                .bankTxnNumber(transactionDto.getBankReferenceNumber() == null ? PaymentConstants.EMPTY : transactionDto.getBankReferenceNumber())
                .bankCode(transactionDto.getPayMode() == null ? PaymentConstants.EMPTY : transactionDto.getPayMode())
                .customerId(order.getCustomerId() == null ? PaymentConstants.EMPTY : order.getCustomerId())
                .orderRetryCount(String.valueOf(order.getOrderRetryCount()) == null ? PaymentConstants.EMPTY : String.valueOf(order.getOrderRetryCount()))
                .build();
    }
    /**
     * @return: FinalResponseStatus
     * @methodName: getStatus
     * @@Method-Description: Process setting response status
     * @param: transactionDto,order,channelStatus,failureReason
     * @Exception: or @Error :Exception
     */
    public FinalResponseStatus getStatus(TransactionDto transactionDto, Order order, String channelStatus, String failureReason){
        if(!transactionDto.getOrderAmount().equals(order.getOrderAmount())){
            return FinalResponseStatus.builder().status(PaymentConstants.FAILED).responseReason(PaymentConstants.FAILED_FOR_AMOUNT_NOT_MATCHED).build();
        }else{
            return FinalResponseStatus.builder().status(channelStatus).responseReason(failureReason.replaceAll(PaymentConstants.SPECIAL_CHAR_REGEX,PaymentConstants.EMPTY)).build();
        }
    }

    public PaymentInitiationRequest getInitiationRequest(PaymentRequest paymentRequest){
        return PaymentInitiationRequest.builder()
                .atrn(paymentRequest.getAtrn())
                .paymode(PaymentConstants.NB_CONST)
                .build();
    }

    public NbMapWebResponseDto getCallBackResponse(NbMapWebResponseDto nbMapWebResponseDto) {
        return NbMapWebResponseDto.builder()
                .sbirefNo(nbMapWebResponseDto.getSbirefNo())
                .amount(nbMapWebResponseDto.getAmount())
                .txnrefNo(nbMapWebResponseDto.getTxnrefNo())
                .status(nbMapWebResponseDto.getStatus())
                .status_desc(nbMapWebResponseDto.getStatus_desc())
                .checkSum(nbMapWebResponseDto.getCheckSum())
                .build();
    }

    public void getData(Map<String, String> map) {
        paymentInbValidator.validateNBAmountCallBack(map.get(PaymentConstants.AMOUNT),PaymentConstants.AMOUNT);
        paymentInbValidator.validateNBRequiredCallBack(map.get(PaymentConstants.AMOUNT),PaymentConstants.AMOUNT);
        paymentInbValidator.validateNBRequiredCallBack(map.get(PaymentConstants.TXN_REF_NO),PaymentConstants.TXN_REF_NO);
        paymentInbValidator.validateNBRequiredCallBack(map.get(PaymentConstants.STATUS),PaymentConstants.STATUS);
        paymentInbValidator.validateNBRequiredCallBack(map.get(PaymentConstants.STATUS_DESC),PaymentConstants.STATUS_DESC);
    }
}

