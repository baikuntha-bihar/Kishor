        checkMandatoryField(nbCallBackResponse.getAmount(), PaymentConstants.AMOUNT);
        checkMandatoryField(nbCallBackResponse.getTxnrefNo(), PaymentConstants.TXN_REF_NO);
        checkMandatoryField(nbCallBackResponse.getStatus(), PaymentConstants.STATUS);
        checkMandatoryField(nbCallBackResponse.getStatus_desc(), PaymentConstants.STATUS_DESC);
