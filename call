            addError(fieldName, CashChallanErrorConstants.FIXED_FIELD_LENGTH_ERROR_CODE, MessageFormat.format(CashChallanErrorConstants.FIXED_FIELD_LENGTH_ERROR_MESSAGE, fieldName, maxLength));
        }
    }

    protected void validateFieldLengthMaxForCash(String value, int maxLength, String fieldName) {
        if (StringUtils.isNotEmpty(value) && value.length() > maxLength) {
            addError(CashChallanErrorConstants.MAX_LENGTH_ERROR_CODE, CashChallanErrorConstants.MAX_LENGTH_ERROR_MESSAGE, fieldName, maxLength);
        }
    }

    protected void validateFieldWithRegexForCash(String value, String regex, String fieldName, String reason) {
        if (StringUtils.isNotEmpty(value) && validate(value, regex)) {
            addError(fieldName, CashChallanErrorConstants.INVALID_ERROR_CODE, MessageFormat.format(CashChallanErrorConstants.INVALID_ERROR_MESSAGE, fieldName, reason));
        }
