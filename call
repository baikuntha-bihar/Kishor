package com.epay.payment.dao;


import com.epay.payment.config.CardConfigDeatils;
import com.epay.payment.config.StandardConfig;
import com.epay.payment.dto.CallBackPaymentFinalResponseDto;
import com.epay.payment.dto.TransactionDto;
import com.epay.payment.entity.Order;
import com.epay.payment.exceptions.PaymentException;
import com.epay.payment.externalservice.KmsServicesClient;
import com.epay.payment.model.response.KMSEncryptionKeysResponse;
import com.epay.payment.model.response.PaymentFinalResponse;
import com.epay.payment.model.response.PaymentResponse;
import com.epay.payment.util.ErrorConstants;
import com.epay.payment.util.PaymentConstants;
import com.sbi.epay.logging.utility.LoggerFactoryUtility;
import com.sbi.epay.logging.utility.LoggerUtility;
import lombok.RequiredArgsConstructor;
import org.apache.commons.collections4.CollectionUtils;
import org.springframework.stereotype.Component;

import java.text.MessageFormat;
import java.util.List;

import static com.epay.payment.util.EncryptionDecryptionUtil.decryptValue;
import static com.epay.payment.util.EncryptionDecryptionUtil.encryptValue;
import static com.epay.payment.util.PaymentConstants.STANDARD_COMMON_MID;
import static com.epay.payment.util.PaymentUtil.toJson;

/**
 * Class Name: PaymentCallbackForwardDao
 * *
 * PaymentCallbackForwardDao is responsible for validating API KeyId And Scrt with the Kms Service
 *  and retrieves the encryption key for a given merchant ID
 * Author: VCE2656 - Vinod Bhosale
 * Copyright (c) 2024 [State Bank of India]
 * All rights reserved
 * *
 * Version:1.0
 */
@Component
@RequiredArgsConstructor
public class PaymentCallbackForwardDao {
    private final PaymentDao paymentDao;
    private final KmsServicesClient kmsServicesClient;
    private final CardConfigDeatils cardConfigDeatils;
    private final StandardConfig standardConfig;

    LoggerUtility logger = LoggerFactoryUtility.getLogger(this.getClass());

    /**
     * @param mid:String
     * @return String
     */
    public String getMerchantMekKey(String mid) {
        if (standardConfig.getMIdList().contains(mid)) {
            mid = STANDARD_COMMON_MID;
        }
        KMSEncryptionKeysResponse encryptionKeysResponse = getMekByMid(mid);
        String kek = decryptValue(encryptionKeysResponse.getAek(), encryptionKeysResponse.getKek());
        return decryptValue(kek, encryptionKeysResponse.getMek());
    }

    /**
     * @param mId:String
     * @return String
     */
    private KMSEncryptionKeysResponse getMekByMid(String mId) {
        PaymentResponse<KMSEncryptionKeysResponse> kmsResponse = kmsServicesClient.getEncryptionKeys(mId);
        if (PaymentConstants.RESPONSE_SUCCESS == kmsResponse.getStatus() && CollectionUtils.isNotEmpty(kmsResponse.getData())) {
            KMSEncryptionKeysResponse encryptionKeyResponse = kmsResponse.getData().getFirst();
            encryptionKeyResponse.setAek(cardConfigDeatils.getAek());
            return encryptionKeyResponse;
        } else if (CollectionUtils.isNotEmpty(kmsResponse.getErrors())) {
            throw new PaymentException(kmsResponse.getErrors().toString(),"Merchant Encryption Keys");
        }
        throw new PaymentException(ErrorConstants.NOT_FOUND_ERROR_CODE, MessageFormat.format(ErrorConstants.NOT_FOUND_ERROR_MESSAGE, "Merchant Encryption Keys"));
    }


    public String buildEncryptedResponse(PaymentFinalResponse paymentFinalResponse, String encryptedResponse, String url, TransactionDto transactionDto, Order order, String mek) {
        CallBackPaymentFinalResponseDto callBackPaymentFinalResponseDto = buildEncryptedFinalResponse(paymentFinalResponse, encryptedResponse, url,transactionDto,order);
        PaymentResponse<CallBackPaymentFinalResponseDto> transactionResponse=PaymentResponse.<CallBackPaymentFinalResponseDto>builder().data(List.of(callBackPaymentFinalResponseDto)).status(1).build();
        logger.info("transactionResponse. {}",transactionResponse);
        String encryptionKey = paymentDao.findAesKeyBySbiOrderRefNumber(paymentFinalResponse.getSbiOrderId(),order.getMId(),mek);
        return encryptValue(encryptionKey, toJson(transactionResponse));
    }

    private CallBackPaymentFinalResponseDto buildEncryptedFinalResponse(PaymentFinalResponse paymentFinalResponse, String encryptedResponse, String url,TransactionDto transactionDto, Order order) {
        return CallBackPaymentFinalResponseDto.builder()
                .encryptedPaymentFinalResponse(encryptedResponse)
                .orderRetryCount(paymentFinalResponse.getOrderRetryCount())
                .atrnNumber(paymentFinalResponse.getAtrn())
                .transactionStatus(paymentFinalResponse.getTransactionStatus())
                .reason(paymentFinalResponse.getReason())
                .sbiOrderRefNumber(paymentFinalResponse.getSbiOrderId())
                .orderRefNumber(paymentFinalResponse.getMerchantOrderNumber())
                .totalAmount(paymentFinalResponse.getTotalAmount())
                .returnUrl(order.getReturnUrl())
                .currencyCode(transactionDto.getCurrencyCode())
                .mId(transactionDto.getMerchantId())
                .build();
    }

}
