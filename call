    public static List<String> getNullFields(NeftRtgsDealerValidationDto neftRtgsDealerValidationDto) {
        Class<?> clazz = neftRtgsDealerValidationDto.getClass();

        return Arrays.stream(neftRtgsDealerValidationDto.getClass().getDeclaredFields())
                .peek(field -> field.setAccessible(true)) // Allows access to private fields
                .filter(field -> {
                    try {
                        Object value = field.get(neftRtgsDealerValidationDto);
                        if(value == null){
                            return true;
                        }
                        if(value instanceof String str){
                            return str.isBlank() || str.trim().equalsIgnoreCase("null");
                        }
                        return false;
                        //return field.get(neftRtgsDealerValidationDto) == null || (field.get(neftRtgsDealerValidationDto) instanceof String s && s.isBlank()); // Check if the field value is null
                    } catch (IllegalAccessException e) {
                        // Handle potential access exceptions
                        throw new RuntimeException("Error accessing field: " + field.getName(), e);
                    }
                })
                .map(Field::getName) // Map to the field name
                .collect(Collectors.toList()); // Collect the names into a list
    }

    public static List<String> getLeadingTrailingSpaces(NeftRtgsDealerValidationDto neftRtgsDealerValidationDto) {
        Class<?> clazz = neftRtgsDealerValidationDto.getClass();

        return Arrays.stream(clazz.getDeclaredFields())
                .peek(field -> field.setAccessible(true)) // Allows access to private fields
                .filter(field -> {
                    try {
                        return field.get(neftRtgsDealerValidationDto) != null && (field.get(neftRtgsDealerValidationDto) instanceof String s && !s.equals(s.trim())); // Check if the field value is null
                    } catch (IllegalAccessException e) {
                        // Handle potential access exceptions
                        throw new RuntimeException("Error accessing field: " + field.getName(), e);
                    }
                })
                .map(Field::getName) // Map to the field name
                .collect(Collectors.toList()); // Collect the names into a list
    }

    public Map<String,String> getCSCWalletDecryptedData(String decResponse) {
        return Optional.of(Arrays.stream(decResponse.split(PaymentConstants.INB_PIPE_CONST))
                        .map(kv -> kv.split(PaymentConstants.PATTERN_EQUAL_TO_CONST))
                        .filter(kvArray -> kvArray.length == 2)
                        .collect(Collectors.toMap(kv -> kv[0], kv ->StringUtils.isBlank(kv[1])?PaymentConstants.NA:kv[1])))
                .orElseThrow(() ->new PaymentException(InbErrorConstants.WEB_CHECKSUM_ERROR_CODE, InbErrorConstants.WEB_CHECKSUM_MISMATCH_ERROR_MESSAGE));
    }

